<UserControl x:Class="TweakHub.Views.OptionalServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TweakHub.Localization">
    <UserControl.Resources><ResourceDictionary Source="SectionStyles.xaml"/></UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,12,0">
        <StackPanel x:Name="ContentPanel">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Maintenance:ServicesTitle}" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{loc:Loc Maintenance:ServicesDescription}" Style="{StaticResource DescriptionTextStyle}"/>
                    <Button Content="{loc:Loc Security:Refresh}" Click="Refresh_Click" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource DescriptionTextStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="ServicesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource DescriptionTextStyle}"/>
                                <TextBlock Style="{StaticResource DescriptionTextStyle}" Margin="0,6,0,0">
                                    <Run Text="{Binding ModeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Status, Mode=OneWay}"/>
                                </TextBlock>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{loc:Loc Maintenance:Manual}" Tag="3" Click="Change_Click" IsEnabled="{Binding CanChange}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"/>
                                    <Button Content="{loc:Loc Maintenance:Disabled}" Tag="4" Click="Change_Click" IsEnabled="{Binding CanChange}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"/>
                                    <Button Content="{loc:Loc Devices:RestoreOriginal}" Tag="Restore" Click="Change_Click" IsEnabled="{Binding Managed}"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
