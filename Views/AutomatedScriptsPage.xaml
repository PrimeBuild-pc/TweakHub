<Page x:Class="TweakHub.Views.AutomatedScriptsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:TweakHub.Localization"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{loc:Loc Scripts:AutomatedScriptsPageAutomatedScripts}"
      Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="FavoriteScriptStarTemplate">
            <TextBlock FontSize="18">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="☆"/>
                        <Setter Property="Foreground" Value="{DynamicResource IconSecondaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter Property="Text" Value="★"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <Style x:Key="ScriptCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <DataTemplate x:Key="BuiltInScriptTemplate">
            <Border Style="{StaticResource ScriptCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,8,0"
                                       Foreground="{DynamicResource IconBrush}"/>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="8,0,0,0"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                                       ToolTip="{Binding CompletionToolTip}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource DescriptionTextStyle}" Margin="26,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="6,2">
                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FavoriteStarButtonStyle}" Margin="0,0,8,0"
                                Click="FavoriteScript_Click" ToolTip="{loc:Loc Scripts:FavoriteScript}"
                                AutomationProperties.Name="{loc:Loc Scripts:FavoriteScript}" Content="{Binding}"
                                ContentTemplate="{StaticResource FavoriteScriptStarTemplate}"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                Click="BuiltInScript_View_Click" Tag="{Binding ElementName=PreviewPanel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc Scripts:AutomatedScriptsPageView}" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ExecuteButtonStyle}" Click="BuiltInScript_Execute_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"
                                           Foreground="{DynamicResource AccentForegroundBrush}"/>
                                <TextBlock Text="{Binding ExecuteText}" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border x:Name="PreviewPanel" Tag="{Binding ElementName=PreviewText}"
                            Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" CornerRadius="8"
                            BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="150"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Loc Scripts:AutomatedScriptsPageDetails}" FontWeight="SemiBold" Margin="12,8,12,4"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <Border Grid.Row="1" Margin="12" CornerRadius="6"
                                    BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                                             FontSize="13" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             SelectionTextBrush="{DynamicResource AccentForegroundBrush}"/>
                                </ScrollViewer>
                            </Border>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Click="CopyBuiltInScript_Click"
                                        Tag="{Binding ElementName=PreviewText}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Loc Scripts:AutomatedScriptsPageCopy}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlaybookTemplate">
            <Border Style="{StaticResource ScriptCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,8,0"
                                       Foreground="{DynamicResource IconBrush}"/>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource DescriptionTextStyle}" Margin="26,0,0,4"/>
                        <TextBlock Text="{Binding StepSummary}" FontSize="11" Margin="26,0,0,0"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:Loc Scripts:Run}" Style="{StaticResource ExecuteButtonStyle}" Margin="0,0,8,0"
                                AutomationProperties.Name="{loc:Loc Scripts:Run}" Click="RunPlaybook_Click"/>
                        <Button Content="{loc:Loc Scripts:AutomatedScriptsPageEdit}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                AutomationProperties.Name="{loc:Loc Scripts:AutomatedScriptsPageEdit}" Click="EditPlaybook_Click"/>
                        <Button Content="{loc:Loc Scripts:AutomatedScriptsPageDelete}" Style="{StaticResource DangerButtonStyle}"
                                AutomationProperties.Name="{loc:Loc Scripts:AutomatedScriptsPageDelete}" Click="DeletePlaybook_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CustomScriptTemplate">
            <Border Style="{StaticResource ScriptCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,8,0"
                                       Foreground="{DynamicResource IconBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE8B7;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Language}" Value="Cmd">
                                                <Setter Property="Text" Value="&#xE8A5;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        </StackPanel>
                        <TextBlock Margin="26,0,0,8" Style="{StaticResource DescriptionTextStyle}">
                            <Run>
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="PowerShell"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Language}" Value="Cmd">
                                                <Setter Property="Text" Value="CMD"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run><Run Text=" • "/>
                            <Run>
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="{loc:Loc Scripts:CurrentUser}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RequiresAdministrator}" Value="True">
                                                <Setter Property="Text" Value="{loc:Loc Scripts:Administrator}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FavoriteStarButtonStyle}" Margin="0,0,8,0"
                                Click="FavoriteScript_Click" ToolTip="{loc:Loc Scripts:FavoriteScript}"
                                AutomationProperties.Name="{loc:Loc Scripts:FavoriteScript}" Content="{Binding}"
                                ContentTemplate="{StaticResource FavoriteScriptStarTemplate}"/>
                        <Button Style="{StaticResource ExecuteButtonStyle}" Margin="0,0,8,0"
                                Click="ExecuteCustomScript_Click" Tag="{Binding ElementName=CancelScriptButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0"
                                           Foreground="{DynamicResource AccentForegroundBrush}"/>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{loc:Loc Scripts:Run}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Language}" Value="Cmd">
                                                    <Setter Property="Text" Value="{loc:Loc Scripts:Execute}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelScriptButton" Content="{loc:Loc Scripts:AutomatedScriptsPageStop}" Style="{StaticResource DangerButtonStyle}"
                                Margin="0,0,8,0" Visibility="Collapsed" Click="CancelCustomScript_Click"/>
                        <Button Content="{loc:Loc Scripts:AutomatedScriptsPageExport}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                Click="ExportCustomScript_Click"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="EditCustomScript_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="{loc:Loc Scripts:AutomatedScriptsPageEdit}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButtonStyle}" Click="DeleteCustomScript_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="{loc:Loc Scripts:AutomatedScriptsPageDelete}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Loc Scripts:AutomatedScriptsPageAutomatedScripts2}" FontSize="28" FontWeight="Light"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="{loc:Loc Scripts:AutomatedScriptsPageRunMaintenanceCommandsAndManage}"
                           FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                <Button x:Name="OpenAppsFolderButton" AutomationProperties.Name="{loc:Loc Scripts:AppsFolder}"
                        Style="{StaticResource SecondaryButtonStyle}" Click="OpenAppsFolder_Click" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc Scripts:AppsFolder}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button x:Name="NewPlaybookButton" AutomationProperties.Name="{loc:Loc Scripts:NewPlaybook}"
                        Style="{StaticResource SecondaryButtonStyle}" Click="NewPlaybook_Click" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc Scripts:NewPlaybook}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{loc:Loc Scripts:AutomatedScriptsPageImport}"
                        Style="{StaticResource SecondaryButtonStyle}" Click="ImportScriptsButton_Click" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc Scripts:AutomatedScriptsPageImport}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernButtonStyle}" Click="NewScriptButton_Click" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"
                                   Foreground="{DynamicResource AccentForegroundBrush}"/>
                        <TextBlock Text="{loc:Loc Scripts:AutomatedScriptsPageNewScript}" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Loc Scripts:Playbooks}" Style="{StaticResource CategoryHeaderStyle}" Margin="0,0,0,8"/>
                <TextBlock Text="{loc:Loc Scripts:PlaybooksDescription}" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,12"/>
                <ItemsControl x:Name="PlaybooksControl" ItemTemplate="{StaticResource PlaybookTemplate}" Margin="0,0,0,16"/>
                <TextBlock Text="{loc:Loc Scripts:BuiltInScripts}" Style="{StaticResource CategoryHeaderStyle}" Margin="0,0,0,8"/>
                <ItemsControl x:Name="BuiltInScriptsControl" ItemTemplate="{StaticResource BuiltInScriptTemplate}"/>
                <TextBlock Text="{loc:Loc Scripts:CustomScripts}" Style="{StaticResource CategoryHeaderStyle}" Margin="0,12,0,8"/>
                <TextBlock Text="{loc:Loc Scripts:ScriptFileImportDescription}" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,12"/>
                <ItemsControl x:Name="CustomScriptsControl" ItemTemplate="{StaticResource CustomScriptTemplate}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
