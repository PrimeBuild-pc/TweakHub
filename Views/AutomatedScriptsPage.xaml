<Page x:Class="TweakHub.Views.AutomatedScriptsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:local="clr-namespace:TweakHub.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Automated Scripts"
      Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">

    <Page.Resources>
        <Style x:Key="ScriptCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.1" ShadowDepth="1" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExecuteButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Reset button -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Automated Scripts"
                           FontSize="28" FontWeight="Light"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Execute automated scripts for bulk system optimizations and hardware-specific improvements."
                           FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                <Button x:Name="ResetAllTweaksHeaderButton" Style="{StaticResource DangerButtonStyle}" Click="ResetAllTweaks_Click" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                        <TextBlock Text="Reset All Tweaks" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button x:Name="NewScriptButton" Style="{StaticResource ModernButtonStyle}" Click="NewScriptButton_Click" Margin="8,0,0,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                        <TextBlock Text="New Script" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Scripts List -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ScriptsHostPanel">
                <!-- Gaming Optimization Script -->
                <Border Style="{StaticResource ScriptCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🎮" FontSize="18" Margin="0,0,8,0"
                                           Foreground="{DynamicResource IconBrush}"/>
                                <TextBlock Text="Gaming Performance Optimization"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Comprehensive gaming optimization including GPU settings, CPU priority, memory management, and network tweaks."
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="26,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="5,2" Margin="0,0,6,0">
                                    <TextBlock Text="GPU" FontSize="9" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="5,2" Margin="0,0,6,0">
                                    <TextBlock Text="CPU" FontSize="9" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="5,2" Margin="0,0,6,0">
                                    <TextBlock Text="Memory" FontSize="9" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="5,2">
                                    <TextBlock Text="Network" FontSize="9" Foreground="White" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ModernButtonStyle}" Click="GamingOptimization_View_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👁️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="View" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ExecuteButtonStyle}" Click="GamingOptimization_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="Execute" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Inline preview area -->
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" CornerRadius="8" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" x:Name="GamingPreviewPanel">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="Height" Value="0"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="12,8,12,4">
                                    <TextBlock Text="Details" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Border Grid.Row="1" Margin="12" CornerRadius="6" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="GamingPreviewText" IsReadOnly="True" TextWrapping="Wrap"
                                                 FontFamily="Consolas" FontSize="13" Background="Transparent" BorderThickness="0"/>
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                                    <Button Style="{StaticResource ModernButtonStyle}" Padding="12,6" Click="CopyScript_Click" Tag="{x:Reference GamingPreviewText}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" Margin="0,0,6,0"/>
                                            <TextBlock Text="Copy"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- System Cleanup Script -->
                <Border Style="{StaticResource ScriptCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🧹" FontSize="18" Margin="0,0,8,0"
                                           Foreground="{DynamicResource IconBrush}"/>
                                <TextBlock Text="Deep System Cleanup"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Comprehensive system cleanup including temp files, cache, logs, and unnecessary system files."
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="26,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                <Border Background="{StaticResource SuccessBrush}" CornerRadius="8" Padding="5,2" Margin="0,0,6,0">
                                    <TextBlock Text="Safe" FontSize="9" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="6,2">
                                    <TextBlock Text="Disk Space" FontSize="10" Foreground="White" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ModernButtonStyle}" Click="SystemCleanup_View_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👁️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="View" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ExecuteButtonStyle}" Click="SystemCleanup_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="Execute" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" CornerRadius="8" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" x:Name="CleanupPreviewPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="12,8,12,4">
                                    <TextBlock Text="Details" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Border Grid.Row="1" Margin="12" CornerRadius="6" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="CleanupPreviewText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Background="Transparent" BorderThickness="0"/>
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                                    <Button Style="{StaticResource ModernButtonStyle}" Padding="12,6" Click="CopyScript_Click" Tag="{x:Reference CleanupPreviewText}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" Margin="0,0,6,0"/>
                                            <TextBlock Text="Copy"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Network Optimization Script -->
                <Border Style="{StaticResource ScriptCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🌐" FontSize="18" Margin="0,0,8,0"
                                           Foreground="{DynamicResource IconBrush}"/>
                                <TextBlock Text="Network Performance Boost"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Optimize network settings for reduced latency and improved throughput."
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="26,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                <Border Background="{StaticResource WarningBrush}" CornerRadius="10" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Moderate Risk" FontSize="10" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="6,2">
                                    <TextBlock Text="Network" FontSize="10" Foreground="White" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ModernButtonStyle}" Click="NetworkOptimization_View_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👁️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="View" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ExecuteButtonStyle}" Click="NetworkOptimization_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="Execute" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" CornerRadius="8" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" x:Name="NetworkPreviewPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="12,8,12,4">
                                    <TextBlock Text="Details" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Border Grid.Row="1" Margin="12" CornerRadius="6" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="NetworkPreviewText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Background="Transparent" BorderThickness="0"/>
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                                    <Button Style="{StaticResource ModernButtonStyle}" Padding="12,6" Click="CopyScript_Click" Tag="{x:Reference NetworkPreviewText}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" Margin="0,0,6,0"/>
                                            <TextBlock Text="Copy"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Hardware Detection and Optimization -->
                <Border Style="{StaticResource ScriptCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🔧" FontSize="18" Margin="0,0,8,0"
                                           Foreground="{DynamicResource IconBrush}"/>
                                <TextBlock Text="Hardware-Specific Optimization"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Detect your hardware (Intel/AMD/Nvidia) and apply manufacturer-specific optimizations."
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="26,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="5,2" Margin="0,0,6,0">
                                    <TextBlock Text="Intel" FontSize="9" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="AMD" FontSize="10" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="6,2">
                                    <TextBlock Text="Nvidia" FontSize="10" Foreground="White" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ModernButtonStyle}" Click="HardwareOptimization_View_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👁️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="View" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ExecuteButtonStyle}" Click="HardwareOptimization_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="Execute" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" CornerRadius="8" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" x:Name="HardwarePreviewPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="12,8,12,4">
                                    <TextBlock Text="Details" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Border Grid.Row="1" Margin="12" CornerRadius="6" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="HardwarePreviewText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Background="Transparent" BorderThickness="0"/>
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                                    <Button Style="{StaticResource ModernButtonStyle}" Padding="12,6" Click="CopyScript_Click" Tag="{x:Reference HardwarePreviewText}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" Margin="0,0,6,0"/>
                                            <TextBlock Text="Copy"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Removed standalone Reset All Tweaks card (moved to header) -->

                <!-- Audio Loudness Equalization Script -->
                <Border Style="{StaticResource ScriptCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🔊" FontSize="18" Margin="0,0,8,0"
                                           Foreground="{DynamicResource IconBrush}"/>
                                <TextBlock Text="Enable Audio Loudness Equalization"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Enable loudness equalization for selected audio output device to normalize volume levels across different content."
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="26,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                <Border Background="{StaticResource SuccessBrush}" CornerRadius="8" Padding="5,2" Margin="0,0,6,0">
                                    <TextBlock Text="Safe" FontSize="9" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="5,2">
                                    <TextBlock Text="Audio" FontSize="9" Foreground="White" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ModernButtonStyle}" Click="AudioLoudnessEqualization_View_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👁️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="View" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ExecuteButtonStyle}" Click="AudioLoudnessEqualization_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="Execute" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" CornerRadius="8" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" x:Name="AudioPreviewPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="12,8,12,4">
                                    <TextBlock Text="Details" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Border Grid.Row="1" Margin="12" CornerRadius="6" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="AudioPreviewText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Background="Transparent" BorderThickness="0"/>
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                                    <Button Style="{StaticResource ModernButtonStyle}" Padding="12,6" Click="CopyScript_Click" Tag="{x:Reference AudioPreviewText}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" Margin="0,0,6,0"/>
                                            <TextBlock Text="Copy"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- WinGet Installation Script -->
                <Border Style="{StaticResource ScriptCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="📦" FontSize="18" Margin="0,0,8,0"
                                           Foreground="{DynamicResource IconBrush}"/>
                                <TextBlock Text="Install WinGet Package Manager"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Install Microsoft WinGet package manager if not present. Includes multiple installation methods with automatic fallback."
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="26,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                <Border Background="{StaticResource SuccessBrush}" CornerRadius="8" Padding="5,2" Margin="0,0,6,0">
                                    <TextBlock Text="Safe" FontSize="9" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="6,2">
                                    <TextBlock Text="Package Manager" FontSize="10" Foreground="White" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ModernButtonStyle}" Click="WinGetInstallation_View_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👁️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
