<Page x:Class="TweakHub.Views.AutomatedScriptsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:local="clr-namespace:TweakHub.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Automated Scripts"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="ScriptCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </Page.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Automated Scripts"
                           FontSize="28" FontWeight="Light"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Run maintenance commands and manage your custom PowerShell or CMD scripts."
                           FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                <Button Style="{StaticResource SecondaryButtonStyle}" Click="ImportScriptsButton_Click" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="Import" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button x:Name="NewScriptButton" Style="{StaticResource ModernButtonStyle}" Click="NewScriptButton_Click" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" Foreground="White"/>
                        <TextBlock Text="New Script" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Scripts List -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ScriptsHostPanel">
                <!-- WinGet Installation Script -->
                <Border Style="{StaticResource ScriptCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,8,0"
                                           Foreground="{DynamicResource IconBrush}"/>
                                <TextBlock Text="Install WinGet Package Manager"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Install Microsoft WinGet package manager if not present. Includes multiple installation methods with automatic fallback."
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="26,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                <Border Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="5,2" Margin="0,0,6,0">
                                    <TextBlock Text="Safe" FontSize="9" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="6,2">
                                    <TextBlock Text="Package Manager" FontSize="10" Foreground="White" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Click="WinGetInstallation_View_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="View" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ExecuteButtonStyle}" Click="WinGetInstallation_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="Execute" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" CornerRadius="8" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" x:Name="WinGetPreviewPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="12,8,12,4">
                                    <TextBlock Text="Details" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Border Grid.Row="1" Margin="12" CornerRadius="6" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="WinGetPreviewText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Background="Transparent" BorderThickness="0"/>
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Click="CopyScript_Click" Tag="{x:Reference WinGetPreviewText}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0"/>
                                            <TextBlock Text="Copy"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- DISM + SFC System Repair Script -->
                <Border Style="{StaticResource ScriptCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,8,0"
                                           Foreground="{DynamicResource IconBrush}"/>
                                <TextBlock Text="DISM + SFC System Repair"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Run comprehensive Windows system file integrity checks and repairs"
                                       Style="{StaticResource DescriptionTextStyle}"
                                       Margin="26,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                <Border Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="5,2" Margin="0,0,6,0">
                                    <TextBlock Text="Safe" FontSize="9" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="6,2">
                                    <TextBlock Text="Repair" FontSize="10" Foreground="White" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Click="DismSfcRepair_View_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="View" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ExecuteButtonStyle}" Click="DismSfcRepair_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" Foreground="White"/>
                                    <TextBlock Text="Run Repair" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" CornerRadius="8" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" x:Name="DismPreviewPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="12,8,12,4">
                                    <TextBlock Text="Details" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Border Grid.Row="1" Margin="12" CornerRadius="6" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="DismPreviewText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Background="Transparent" BorderThickness="0"/>
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Click="CopyScript_Click" Tag="{x:Reference DismPreviewText}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0"/>
                                            <TextBlock Text="Copy"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        
    </Grid>
</Page>
