<UserControl x:Class="TweakHub.Views.DeviceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TweakHub.Localization"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:TweakHub.Views.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="AdviceIconStyle" TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Text" Value=""/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Rule.Advice}" Value="Common">
                        <Setter Property="Text" Value="&#xE73E;"/>
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Rule.Advice}" Value="Situational">
                        <Setter Property="Text" Value="&#xE946;"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Rule.Advice}" Value="Avoid">
                        <Setter Property="Text" Value="&#xE7BA;"/>
                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,12,0">
        <StackPanel>
            <Grid Margin="4,0,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Devices:DevicesDescription}" Style="{StaticResource DescriptionTextStyle}"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource DescriptionTextStyle}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button x:Name="ScanButton" Click="Scan_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc Devices:Scan}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="EnableAllButton" Click="EnableAll_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            ToolTip="{loc:Loc Devices:EnableAllHint}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc Devices:EnableAll}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportButton" Click="Export_Click" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc Devices:Export}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="4,0,4,8" Visibility="Collapsed"/>

            <UniformGrid Columns="4">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="&#xE772;" Style="{StaticResource IconTextStyle}" FontSize="20" HorizontalAlignment="Left" Margin="0,0,0,8"
                                   Foreground="{DynamicResource IconBrush}"/>
                        <TextBlock Text="{loc:Loc Devices:TileTotal}" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock x:Name="TotalValue" Text="–" Style="{StaticResource TileValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="&#xE82F;" Style="{StaticResource IconTextStyle}" FontSize="20" HorizontalAlignment="Left" Margin="0,0,0,8"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{loc:Loc Devices:TileSuggested}" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock x:Name="SuggestedValue" Text="–" Style="{StaticResource TileValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="&#xE8D8;" Style="{StaticResource IconTextStyle}" FontSize="20" HorizontalAlignment="Left" Margin="0,0,0,8"
                                   Foreground="{DynamicResource IconBrush}"/>
                        <TextBlock Text="{loc:Loc Devices:TileDisabled}" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock x:Name="DisabledValue" Text="–" Style="{StaticResource TileValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ProblemIcon" Text="&#xE7BA;" Style="{StaticResource IconTextStyle}" FontSize="20" HorizontalAlignment="Left"
                                   Margin="0,0,0,8" Foreground="{DynamicResource IconBrush}"/>
                        <TextBlock Text="{loc:Loc Devices:TileProblems}" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock x:Name="ProblemValue" Text="–" Style="{StaticResource TileValueStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Devices:CategoriesTitle}" Style="{StaticResource SectionTitleStyle}"/>
                    <UniformGrid x:Name="CategoryChart" Columns="2"/>
                    <TextBlock Text="{loc:Loc Security:ChartFilterHint}" Style="{StaticResource DescriptionTextStyle}" FontSize="11" Margin="0,0,0,12"/>

                    <WrapPanel Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" Width="240" Margin="0,0,12,4" TextChanged="Filter_Changed"
                                 ui:ControlHelper.PlaceholderText="{loc:Loc Security:FilterPlaceholder}"
                                 AutomationProperties.Name="{loc:Loc Security:FilterPlaceholder}"/>
                        <CheckBox x:Name="SuggestedOnly" Content="{loc:Loc Devices:SuggestedOnly}" Margin="0,0,12,4"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </WrapPanel>
                    <DataGrid x:Name="DevicesGrid" Style="{StaticResource TriageGridStyle}" MaxHeight="520"
                              RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Loc Security:ColumnName}" Width="3*" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource AdviceIconStyle}" Width="16" Margin="0,0,8,0" ToolTip="{Binding AdviceText}"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Devices:ColumnClass}" Binding="{Binding Class}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:ColumnCategory}" Binding="{Binding CategoryText}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:ColumnAdvice}" Binding="{Binding AdviceText}" Width="*"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="Toggle_Click" Content="{Binding ToggleText}" Style="{StaticResource SecondaryButtonStyle}"
                                                MinHeight="28" Padding="10,2" AutomationProperties.Name="{Binding ToggleText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <StackPanel Margin="32,4,12,10">
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rule}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding ReasonText}" Style="{StaticResource DescriptionTextStyle}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        <TextBlock Style="{StaticResource DescriptionTextStyle}" Margin="0,2,0,0">
                                            <Run Text="{loc:Loc Devices:Breaks}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding BreaksText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CategoryHintText}" Style="{StaticResource DescriptionTextStyle}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Id}" FontSize="11" FontFamily="Cascadia Mono, Consolas" Margin="0,6,0,0"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    <controls:LoadingOverlay x:Name="Loading"/>
    </Grid>
</UserControl>
