<Window x:Class="TweakHub.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TweakHub.Localization"
        Title="{loc:Loc UI:ProgressWindowProcessing}"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
        FontFamily="Segoe UI Variable Text"
        ResizeMode="NoResize">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <StackPanel Margin="24,20,24,24">
        <TextBlock x:Name="TitleText" Text="{loc:Loc UI:ProgressWindowProcessing2}"
                   Style="{StaticResource DialogHeadingTextStyle}" Margin="0,0,0,14"/>
        <ProgressBar x:Name="ProgressBar" Height="4" Margin="0,0,0,10"
                     Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                     Foreground="{DynamicResource FluentAccentBrush}" Value="0" Maximum="100"/>
        <TextBlock x:Name="StatusText" Text="{loc:Loc UI:ProgressWindowPleaseWait}"
                   Style="{StaticResource DescriptionTextStyle}"/>
    </StackPanel>
</Window>
