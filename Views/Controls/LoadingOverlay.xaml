<UserControl x:Class="TweakHub.Views.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             Visibility="Collapsed" Panel.ZIndex="10">
    <!-- Dims what is on screen while it is being read, so stale values are never mistaken for results. -->
    <Grid>
        <Rectangle Fill="{DynamicResource WindowBackgroundBrush}" Opacity="0.8"/>
        <Border Style="{StaticResource CardStyle}" Padding="28,22" MinWidth="300" MaxWidth="440"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <ui:ProgressRing x:Name="Ring" Width="36" Height="36" IsActive="False" HorizontalAlignment="Center"/>
                <TextBlock x:Name="MessageText" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,14,0,0" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                <TextBlock x:Name="DetailText" Style="{StaticResource DescriptionTextStyle}" TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
