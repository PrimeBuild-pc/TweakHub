<UserControl x:Class="TweakHub.Views.Controls.SectionHeading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Heading" Focusable="False" IsTabStop="False">
    <Grid>
        <TextBlock Text="{Binding PageTitle, ElementName=Heading}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource PageHeadingTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tabs.SelectedIndex, ElementName=Heading, FallbackValue=0}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <DockPanel>
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tabs.SelectedIndex, ElementName=Heading, FallbackValue=0}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <TextBlock FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center">
                <Hyperlink Click="Root_Click" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                    <Hyperlink.Style>
                        <Style TargetType="Hyperlink">
                            <Setter Property="TextDecorations" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Hyperlink.Style>
                    <Run Text="{Binding PageTitle, ElementName=Heading, Mode=OneWay}"/>
                </Hyperlink>
            </TextBlock>
            <Path Data="{StaticResource ChevronIconGeometry}" Style="{StaticResource LineIconStyle}" Margin="10,0"
                  Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBlock Text="{Binding Tabs.SelectedItem.Header, ElementName=Heading}"
                       Style="{StaticResource PageHeadingTextStyle}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
