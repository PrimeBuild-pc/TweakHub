<UserControl x:Class="TweakHub.Views.InterruptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TweakHub.Localization"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:TweakHub.Views.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,12,0">
        <StackPanel>
            <Grid Margin="4,0,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Devices:InterruptsDescription}" Style="{StaticResource DescriptionTextStyle}"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource DescriptionTextStyle}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button x:Name="ScanButton" Click="Scan_Click" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc Devices:Scan}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="4,0,4,8" Visibility="Collapsed"/>

            <UniformGrid Columns="3">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="&#xE964;" Style="{StaticResource IconTextStyle}" FontSize="20" HorizontalAlignment="Left" Margin="0,0,0,8"
                                   Foreground="{DynamicResource IconBrush}"/>
                        <TextBlock Text="{loc:Loc Devices:TilePciDevices}" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock x:Name="DeviceCountValue" Text="–" Style="{StaticResource TileValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="&#xE945;" Style="{StaticResource IconTextStyle}" FontSize="20" HorizontalAlignment="Left" Margin="0,0,0,8"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="{loc:Loc Devices:TileMsi}" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock x:Name="MsiValue" Text="–" Style="{StaticResource TileValueStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="&#xE950;" Style="{StaticResource IconTextStyle}" FontSize="20" HorizontalAlignment="Left" Margin="0,0,0,8"
                                   Foreground="{DynamicResource IconBrush}"/>
                        <TextBlock Text="{loc:Loc Devices:TileAffinity}" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock x:Name="AffinityValue" Text="–" Style="{StaticResource TileValueStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Devices:InterruptModeByClass}" Style="{StaticResource SectionTitleStyle}"/>
                    <UniformGrid x:Name="ClassChart" Columns="2"/>
                    <WrapPanel Margin="0,0,0,12">
                        <ContentControl x:Name="LegendMsi"/>
                    </WrapPanel>

                    <DataGrid x:Name="DevicesGrid" Style="{StaticResource TriageGridStyle}" MaxHeight="360" SelectionChanged="Device_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Security:ColumnName}" Binding="{Binding Name}" Width="3*"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:ColumnClass}" Binding="{Binding Class}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:ColumnMode}" Binding="{Binding ModeText}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:ColumnLimit}" Binding="{Binding LimitText}" Width="Auto"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:ColumnPriority}" Binding="{Binding PriorityText}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:ColumnAffinity}" Binding="{Binding AffinityText}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border x:Name="EditorCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="{loc:Loc Devices:EditorHint}" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Loc Devices:ColumnMode}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="MsiCheckBox" Grid.Column="1" Content="{loc:Loc Devices:UseMsi}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Text="{loc:Loc Devices:ColumnPriority}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,10"/>
                        <ComboBox x:Name="PriorityBox" Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,10"
                                  AutomationProperties.Name="{loc:Loc Devices:ColumnPriority}"/>
                        <TextBlock Grid.Row="2" Text="{loc:Loc Devices:ColumnAffinity}" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <WrapPanel x:Name="CpuPanel"/>
                            <TextBlock Text="{loc:Loc Devices:AffinityHint}" Style="{StaticResource DescriptionTextStyle}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="ApplyButton" Click="Apply_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"
                                ToolTip="{loc:Loc Security:RequiresAdministrator}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc Devices:Apply}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RestoreButton" Click="Restore_Click" Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="{loc:Loc Security:RequiresAdministrator}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc Devices:RestoreOriginal}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    <controls:LoadingOverlay x:Name="Loading"/>
    </Grid>
</UserControl>
