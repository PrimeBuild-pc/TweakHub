<Page x:Class="TweakHub.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="About"
      Background="Transparent">

    <Page.Resources>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="28" Margin="0,0,12,0"
                           Foreground="{DynamicResource IconBrush}"/>
                <TextBlock Text="About &amp; Settings" FontSize="28" FontWeight="Light"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </StackPanel>
            <TextBlock Text="Application information, appearance and updates"
                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource CategoryHeaderStyle}"/>
                        <TextBlock Text="Follow Windows or choose a fixed theme, accent color and backdrop."
                                   Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,12,12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <ComboBox x:Name="ThemeModeComboBox" Grid.Column="1" Margin="0,0,0,12" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Use Windows setting" Tag="System"/>
                                <ComboBoxItem Content="Light" Tag="Light"/>
                                <ComboBoxItem Content="Dark" Tag="Dark"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Accent color" VerticalAlignment="Center" Margin="0,0,12,12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                <CheckBox x:Name="UseSystemAccentCheckBox" Content="Use Windows accent color"
                                          Checked="UseSystemAccent_Changed" Unchecked="UseSystemAccent_Changed"/>
                                <TextBox x:Name="AccentColorTextBox" Margin="0,8,0,0" MaxLength="7" ToolTip="Hex color, for example #0078D4"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Effects" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <CheckBox x:Name="TransparencyCheckBox" Grid.Row="2" Grid.Column="1"
                                      Content="Enable Mica and transparency"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="ApplyAppearanceButton" Content="Apply appearance" Style="{StaticResource ModernButtonStyle}"
                                    Click="ApplyAppearance_Click"/>
                            <TextBlock x:Name="AppearanceResultText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Portable configuration" Style="{StaticResource CategoryHeaderStyle}"/>
                        <TextBlock Text="Export or import custom scripts, Registry tweaks, external tools, favorites and appearance as one JSON profile. Machine-specific rollback backups are never included."
                                   Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="DataPathText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export profile" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ExportProfile_Click" Margin="0,0,8,0"/>
                            <Button Content="Import profile" Style="{StaticResource ModernButtonStyle}"
                                    Click="ImportProfile_Click"/>
                            <TextBlock x:Name="ProfileResultText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource CategoryHeaderStyle}"/>
                        <TextBlock Text="TweakHub checks GitHub Releases when it starts. Updates are downloaded, verified and installed only after your confirmation."
                                   Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CheckForUpdatesButton" Content="Check for updates"
                                    Style="{StaticResource ModernButtonStyle}" Click="CheckForUpdates_Click"/>
                            <TextBlock x:Name="UpdateStatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock Text="© 2025–2026 Prime Build" Margin="0,4,0,14"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="License: MIT License" Margin="0,0,0,6"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock Margin="0,0,0,12">
                            <Hyperlink NavigateUri="https://github.com/PrimeBuild-pc/TweakHub" RequestNavigate="Hyperlink_RequestNavigate">
                                GitHub repository
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,12">
                            <Hyperlink NavigateUri="https://discord.gg/AkuAZMwnGY" RequestNavigate="Hyperlink_RequestNavigate">
                                Discord server
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="This software is provided as is, without warranty of any kind."
                                   TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
