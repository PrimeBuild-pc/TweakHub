<Page x:Class="TweakHub.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:TweakHub.Localization"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{loc:Loc UI:AboutPageAbout}"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingsRowStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="56"/>
        </Style>
        <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CategoryHeaderStyle}">
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource FluentAccentTextBrush}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="32,24,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{loc:Loc UI:AboutPageAboutAmpSettings}" Style="{StaticResource PageHeadingTextStyle}" Margin="0,0,0,6"/>
            <TextBlock Text="{loc:Loc UI:AboutPageApplicationInformationAppearanceAndUpdates}" Style="{StaticResource PageSubtitleTextStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
            <StackPanel>
                <TextBlock Text="{loc:Loc UI:AboutPageAppearance}" Style="{StaticResource SettingsGroupHeaderStyle}" Margin="0,0,0,8"/>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="ThemeLabel" Text="{loc:Loc UI:AboutPageTheme}" Style="{StaticResource SettingsRowTitleStyle}"/>
                            <TextBlock Text="{loc:Loc UI:AboutPageFollowWindowsOrChooseA}" Style="{StaticResource DescriptionTextStyle}"/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeModeComboBox" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                  AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}"
                                  Style="{StaticResource FluentDropDownStyle}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{loc:Loc UI:AboutPageUseWindowsSetting}" Tag="System"/>
                            <ComboBoxItem Content="{loc:Loc UI:AboutPageLight}" Tag="Light"/>
                            <ComboBoxItem Content="{loc:Loc UI:AboutPageDark}" Tag="Dark"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UseSystemAccentLabel" Text="{loc:Loc UI:AboutPageUseWindowsAccentColor}"
                                   Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <ui:ToggleSwitch x:Name="UseSystemAccentToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                         AutomationProperties.LabeledBy="{Binding ElementName=UseSystemAccentLabel}"
                                         VerticalAlignment="Center" Toggled="UseSystemAccent_Changed"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AccentColorLabel" Text="{loc:Loc UI:AboutPageAccentColor}"
                                   Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBox x:Name="AccentColorTextBox" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                 AutomationProperties.LabeledBy="{Binding ElementName=AccentColorLabel}"
                                 Style="{StaticResource FieldInputStyle}" MaxLength="7"
                                 ToolTip="{loc:Loc UI:AboutPageHexColorForExample0078D4}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="EffectsLabel" Text="{loc:Loc UI:AboutPageEffects}" Style="{StaticResource SettingsRowTitleStyle}"/>
                            <TextBlock Text="{loc:Loc UI:AboutPageEnableMicaAndTransparency}" Style="{StaticResource DescriptionTextStyle}"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="TransparencyToggle" Grid.Column="1" Style="{StaticResource SettingSwitchStyle}"
                                         AutomationProperties.LabeledBy="{Binding ElementName=EffectsLabel}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LanguageLabel" Text="{loc:Loc UI:AboutPageLanguage}"
                                   Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="240" VerticalAlignment="Center"
                                  AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}"
                                  Style="{StaticResource FluentDropDownStyle}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{loc:Loc UI:AboutPageUseWindowsSetting2}" Tag="System"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Русский" Tag="ru"/>
                            <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                            <ComboBoxItem Content="Español" Tag="es"/>
                            <ComboBoxItem Content="Italiano" Tag="it"/>
                            <ComboBoxItem Content="日本語" Tag="ja"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="ApplyAppearanceButton" Content="{loc:Loc UI:AboutPageApplyAppearance}" Style="{StaticResource ModernButtonStyle}"
                            Click="ApplyAppearance_Click" Margin="0,0,12,0"/>
                    <TextBlock x:Name="AppearanceResultText" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </WrapPanel>

                <TextBlock Text="{loc:Loc UI:AboutPagePortableConfiguration}" Style="{StaticResource SettingsGroupHeaderStyle}"/>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc UI:AboutPageExportOrImportCustomScripts}"
                                   Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DataPathText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <WrapPanel>
                            <Button Content="{loc:Loc UI:AboutPageExportProfile}" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ExportProfile_Click" Margin="0,0,8,4"/>
                            <Button Content="{loc:Loc UI:AboutPageImportProfile}" Style="{StaticResource ModernButtonStyle}"
                                    Click="ImportProfile_Click" Margin="0,0,8,4"/>
                            <Button Content="{loc:Loc UI:AboutPageImportPreviousCopy}" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ImportPreviousCopy_Click" ToolTip="{loc:Loc UI:AboutPageImportPreviousCopyTip}" Margin="0,0,8,4"/>
                            <TextBlock x:Name="ProfileResultText" Margin="4,0,0,4" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{loc:Loc UI:AboutPageUpdates}" Style="{StaticResource SettingsGroupHeaderStyle}"/>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc UI:AboutPageTweakHubChecksGitHubReleasesWhen}" Style="{StaticResource DescriptionTextStyle}"/>
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource DescriptionTextStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="CheckForUpdatesButton" Grid.Column="1" VerticalAlignment="Center"
                                Content="{loc:Loc UI:AboutPageCheckForUpdates}"
                                Style="{StaticResource ModernButtonStyle}" Click="CheckForUpdates_Click"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="VersionText" Style="{StaticResource SettingsGroupHeaderStyle}"/>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <StackPanel>
                        <TextBlock Text="© 2025–2026 Prime Build" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,10"/>
                        <TextBlock Text="{loc:Loc UI:AboutPageLicenseMITLicense}" Style="{StaticResource SettingsRowTitleStyle}" Margin="0,0,0,6"/>
                        <TextBlock Margin="0,0,0,6">
                            <Hyperlink NavigateUri="https://github.com/PrimeBuild-pc/TweakHub" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="{loc:Loc UI:GitHubRepository}"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,10">
                            <Hyperlink NavigateUri="https://discord.gg/AkuAZMwnGY" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="{loc:Loc UI:DiscordServer}"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{loc:Loc UI:AboutPageThisSoftwareIsProvidedAs}" Style="{StaticResource DescriptionTextStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
