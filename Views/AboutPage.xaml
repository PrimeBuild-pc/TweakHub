<Page x:Class="TweakHub.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:TweakHub.Localization"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{loc:Loc UI:AboutPageAbout}"
      Background="Transparent">

    <Page.Resources>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="28" Margin="0,0,12,0"
                           Foreground="{DynamicResource IconBrush}"/>
                <TextBlock Text="{loc:Loc UI:AboutPageAboutAmpSettings}" FontSize="28" FontWeight="Light"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </StackPanel>
            <TextBlock Text="{loc:Loc UI:AboutPageApplicationInformationAppearanceAndUpdates}"
                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc UI:AboutPageAppearance}" Style="{StaticResource CategoryHeaderStyle}"/>
                        <TextBlock Text="{loc:Loc UI:AboutPageFollowWindowsOrChooseA}"
                                   Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{loc:Loc UI:AboutPageTheme}" VerticalAlignment="Center" Margin="0,0,12,12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <ComboBox x:Name="ThemeModeComboBox" Grid.Column="1" Margin="0,0,0,12" SelectedValuePath="Tag">
                                <ComboBoxItem Content="{loc:Loc UI:AboutPageUseWindowsSetting}" Tag="System"/>
                                <ComboBoxItem Content="{loc:Loc UI:AboutPageLight}" Tag="Light"/>
                                <ComboBoxItem Content="{loc:Loc UI:AboutPageDark}" Tag="Dark"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="{loc:Loc UI:AboutPageAccentColor}" VerticalAlignment="Center" Margin="0,0,12,12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                <CheckBox x:Name="UseSystemAccentCheckBox" Content="{loc:Loc UI:AboutPageUseWindowsAccentColor}"
                                          Checked="UseSystemAccent_Changed" Unchecked="UseSystemAccent_Changed"/>
                                <TextBox x:Name="AccentColorTextBox" Margin="0,8,0,0" MaxLength="7" ToolTip="{loc:Loc UI:AboutPageHexColorForExample0078D4}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="{loc:Loc UI:AboutPageEffects}" VerticalAlignment="Center" Margin="0,0,12,12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <CheckBox x:Name="TransparencyCheckBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"
                                      Content="{loc:Loc UI:AboutPageEnableMicaAndTransparency}"/>

                            <TextBlock Grid.Row="3" Text="{loc:Loc UI:AboutPageLanguage}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <ComboBox x:Name="LanguageComboBox" Grid.Row="3" Grid.Column="1" SelectedValuePath="Tag">
                                <ComboBoxItem Content="{loc:Loc UI:AboutPageUseWindowsSetting2}" Tag="System"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="Русский" Tag="ru"/>
                                <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                                <ComboBoxItem Content="Español" Tag="es"/>
                                <ComboBoxItem Content="Italiano" Tag="it"/>
                                <ComboBoxItem Content="日本語" Tag="ja"/>
                            </ComboBox>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="ApplyAppearanceButton" Content="{loc:Loc UI:AboutPageApplyAppearance}" Style="{StaticResource ModernButtonStyle}"
                                    Click="ApplyAppearance_Click"/>
                            <TextBlock x:Name="AppearanceResultText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc UI:AboutPagePortableConfiguration}" Style="{StaticResource CategoryHeaderStyle}"/>
                        <TextBlock Text="{loc:Loc UI:AboutPageExportOrImportCustomScripts}"
                                   Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="DataPathText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc UI:AboutPageExportProfile}" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ExportProfile_Click" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc UI:AboutPageImportProfile}" Style="{StaticResource ModernButtonStyle}"
                                    Click="ImportProfile_Click"/>
                            <TextBlock x:Name="ProfileResultText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc UI:AboutPageUpdates}" Style="{StaticResource CategoryHeaderStyle}"/>
                        <TextBlock Text="{loc:Loc UI:AboutPageTweakHubChecksGitHubReleasesWhen}"
                                   Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CheckForUpdatesButton" Content="{loc:Loc UI:AboutPageCheckForUpdates}"
                                    Style="{StaticResource ModernButtonStyle}" Click="CheckForUpdates_Click"/>
                            <TextBlock x:Name="UpdateStatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock Text="© 2025–2026 Prime Build" Margin="0,4,0,14"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="{loc:Loc UI:AboutPageLicenseMITLicense}" Margin="0,0,0,6"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock Margin="0,0,0,12">
                            <Hyperlink NavigateUri="https://github.com/PrimeBuild-pc/TweakHub" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="{loc:Loc UI:GitHubRepository}"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,12">
                            <Hyperlink NavigateUri="https://discord.gg/AkuAZMwnGY" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="{loc:Loc UI:DiscordServer}"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{loc:Loc UI:AboutPageThisSoftwareIsProvidedAs}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
