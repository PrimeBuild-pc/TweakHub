<Page x:Class="TweakHub.Views.ExternalToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:controls="clr-namespace:TweakHub.Views.Controls"
      xmlns:loc="clr-namespace:TweakHub.Localization"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{loc:Loc Tools:ExternalToolsPageExternalTools}"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="ToolCardStyle" TargetType="Border" BasedOn="{StaticResource HoverSettingsCardStyle}">
            <Setter Property="MinHeight" Value="68"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ToolSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,4"/>
            <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBaseMediumBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ToolActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CategoryExpanderStyle" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,12,0,16"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Margin="32,24,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="HeaderText">
                <TextBlock Text="{loc:Loc Tools:ExternalToolsPageExternalTools2}" Style="{StaticResource PageHeadingTextStyle}" Margin="0,0,0,6"/>
                <TextBlock Text="{loc:Loc Tools:ExternalToolsPageInstallCuratedToolsOrAdd}" Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>
            <WrapPanel x:Name="ToolbarPanel" Grid.Row="1" Margin="0,12,0,0">
                <TextBox x:Name="SearchBox" Width="196" Margin="0,0,8,4" Style="{StaticResource FieldInputStyle}"
                         ui:ControlHelper.PlaceholderText="{loc:Loc Tools:SearchTools}"
                         AutomationProperties.Name="{loc:Loc Tools:SearchTools}" TextChanged="SearchBox_TextChanged"/>
                <ToggleButton x:Name="FavoritesOnlyButton" Padding="12,6" MinHeight="32"
                              Background="{DynamicResource SubtleFillBrush}"
                              BorderBrush="{DynamicResource SystemControlBorderBaseMediumBrush}" BorderThickness="1"
                              Checked="FavoritesFilter_Changed" Unchecked="FavoritesFilter_Changed" Margin="0,0,8,4"
                              AutomationProperties.Name="{loc:Loc Tools:ExternalToolsPageShowFavoritesOnly}"
                              ToolTip="{loc:Loc Tools:ExternalToolsPageShowFavoritesOnly}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FavoriteIconGeometry}" Style="{StaticResource ToolbarIconStyle}"/>
                        <TextBlock Text="{loc:Loc Tools:ExternalToolsPageFavorites}"/>
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="SelectAllButton" Style="{StaticResource ToolSubtleButtonStyle}" Click="SelectAll_Click"
                        AutomationProperties.Name="{loc:Loc Tools:SelectAll}">
                    <TextBlock Text="{loc:Loc Tools:SelectAll}" Style="{StaticResource ToolbarLabelStyle}"/>
                </Button>
                <Button x:Name="PresetsButton" Style="{StaticResource ToolSubtleButtonStyle}" Click="Presets_Click"
                        AutomationProperties.Name="{loc:Loc Tools:Presets}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc Tools:Presets}" Style="{StaticResource ToolbarLabelStyle}"/>
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource FluentIconFont}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ClearSelectionButton" Style="{StaticResource ToolSubtleButtonStyle}" Click="ClearSelection_Click" Visibility="Collapsed"
                        AutomationProperties.Name="{loc:Loc Tools:ClearSelection}">
                    <TextBlock Text="{loc:Loc Tools:ClearSelection}" Style="{StaticResource ToolbarLabelStyle}"/>
                </Button>
                <Button x:Name="InstallSelectedButton" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,4" Click="InstallSelected_Click" Visibility="Collapsed"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource FluentIconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="InstallSelectedText" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AddToolButton" Style="{StaticResource ToolSubtleButtonStyle}" Click="AddTool_Click"
                        AutomationProperties.Name="{loc:Loc Tools:ExternalToolsPageAddTool}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource AddIconGeometry}" Style="{StaticResource ToolbarIconStyle}"/>
                        <TextBlock Text="{loc:Loc Tools:ExternalToolsPageAddTool}" Style="{StaticResource ToolbarLabelStyle}"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
                <ItemsControl x:Name="ToolsControl"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,16"
                                      Style="{StaticResource CategoryExpanderStyle}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CategoryHeaderStyle}"
                                                   VerticalAlignment="Center" Margin="0"/>
                                        <TextBlock Text="{Binding CountText}" FontSize="12" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Tools}" Margin="0,16,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ToolCard" Style="{StaticResource ToolCardStyle}"
                                                    AutomationProperties.Name="{Binding AutomationName}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding SelectAutomationName}">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanSelect}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                    <TextBlock Grid.Column="1" Text="{Binding ToolIcon}" FontFamily="{StaticResource FluentIconFont}" FontSize="18"
                                                               Margin="0,0,12,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource IconBrush}"/>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Tool.Name}" FontSize="14" FontWeight="Normal" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Tool.Description}" Style="{StaticResource DescriptionTextStyle}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel x:Name="RowActions" Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                                        <Button Click="FavoriteTool_Click" Content="{Binding Tool}" ContentTemplate="{StaticResource FavoriteStarTemplate}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FavoriteStarButtonStyle}">
                                                                    <Setter Property="MinWidth" Value="32"/>
                                                                    <Setter Property="MinHeight" Value="32"/>
                                                                    <Setter Property="ToolTip" Value="{loc:Loc Tools:Favorite}"/>
                                                                    <Setter Property="AutomationProperties.Name" Value="{loc:Loc Tools:AddToFavorites}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tool.IsFavorite}" Value="True">
                                                                            <Setter Property="ToolTip" Value="{loc:Loc Tools:Unfavorite}"/>
                                                                            <Setter Property="AutomationProperties.Name" Value="{loc:Loc Tools:RemoveFromFavorites}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Click="EditTool_Click" ToolTip="{loc:Loc Tools:EditCustomTool}"
                                                                AutomationProperties.Name="{Binding EditAutomationName}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ToolActionButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tool.IsCustom}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FluentIconFont}" FontSize="12"/>
                                                        </Button>
                                                        <Button Click="DeleteTool_Click" ToolTip="{loc:Loc Tools:DeleteCustomTool}"
                                                                AutomationProperties.Name="{Binding DeleteAutomationName}" Margin="4,0,0,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ToolActionButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tool.IsCustom}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FluentIconFont}" FontSize="12"/>
                                                        </Button>
                                                        <Button Click="UninstallTool_Click" ToolTip="{loc:Loc Tools:Uninstall}"
                                                                AutomationProperties.Name="{Binding UninstallAutomationName}"
                                                                Tag="{Binding ElementName=ToolCard}" Margin="6,0,0,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ToolActionButtonStyle}">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanUninstall}" Value="True">
                                                                            <Setter Property="IsEnabled" Value="True"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsWinget}" Value="False">
                                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FluentIconFont}" FontSize="12"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <Button Grid.Column="4" Click="ToolAction_Click" Style="{StaticResource ToolSubtleButtonStyle}"
                                                            Tag="{Binding ElementName=ToolCard}" Margin="12,0,0,0" MinWidth="104" VerticalAlignment="Center"
                                                            IsEnabled="{Binding CanRunAction}" ToolTip="{Binding ActionText}"
                                                            AutomationProperties.Name="{Binding AutomationName}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding ActionIcon}" FontFamily="{StaticResource FluentIconFont}" FontSize="12"
                                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ActionText}" Style="{StaticResource ToolbarLabelStyle}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            <TextBlock x:Name="LoadErrorText" Text="{loc:Loc Tools:LoadToolsFailed}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>
            <controls:LoadingOverlay x:Name="CatalogLoading"/>
        </Grid>

        <Border x:Name="ProgressPanel" Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}"
                BorderThickness="0,1,0,0" Padding="20,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ProgressText" Text="{loc:Loc Tools:ExternalToolsPageDownloading}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,0,6"/>
                <ProgressBar x:Name="ProgressBar" Height="4"
                             Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                             Foreground="{DynamicResource AccentBrush}"
                             Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
