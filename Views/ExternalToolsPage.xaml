<Page x:Class="TweakHub.Views.ExternalToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:TweakHub.Localization"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{loc:Loc Tools:ExternalToolsPageExternalTools}"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="ToolCardStyle" TargetType="Border">
            <Setter Property="Width" Value="300"/>
            <Setter Property="MinHeight" Value="120"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="6,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CategoryExpanderStyle" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,12,0,16"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Loc Tools:ExternalToolsPageExternalTools2}"
                           FontSize="28" FontWeight="Light"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="{loc:Loc Tools:ExternalToolsPageInstallCuratedToolsOrAdd}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Border CornerRadius="6" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                        Margin="0,0,8,0">
                    <Border.Resources>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </Border.Resources>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Margin="8,0,0,0"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource IconSecondaryBrush}"/>
                        <TextBox x:Name="SearchBox" Width="190" Margin="6,0,8,0" BorderThickness="0"
                                 Background="Transparent" FocusVisualStyle="{x:Null}"
                                 VerticalContentAlignment="Center" Padding="0,4" FontSize="12"
                                 TextChanged="SearchBox_TextChanged"/>
                    </DockPanel>
                </Border>
                <ToggleButton x:Name="FavoritesOnlyButton" Padding="12,6" MinHeight="32"
                              Background="{DynamicResource SubtleFillBrush}"
                              BorderBrush="{DynamicResource SystemControlBorderBaseMediumBrush}" BorderThickness="1"
                              Checked="FavoritesFilter_Changed" Unchecked="FavoritesFilter_Changed" Margin="0,0,8,0"
                              ToolTip="{loc:Loc Tools:ExternalToolsPageShowFavoritesOnly}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc Tools:ExternalToolsPageFavorites}"/>
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="AddToolButton" Style="{StaticResource ModernButtonStyle}" Click="AddTool_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0"
                                   Foreground="{DynamicResource AccentForegroundBrush}"/>
                        <TextBlock Text="{loc:Loc Tools:ExternalToolsPageAddTool}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <ItemsControl x:Name="ToolsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="True" Margin="0,0,0,16" Style="{StaticResource CategoryExpanderStyle}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="18"
                                                   Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource IconBrush}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        <TextBlock Text="{Binding CountText}" FontSize="12" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Tools}" Margin="0,16,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ToolCard" Style="{StaticResource ToolCardStyle}"
                                                    ToolTip="{Binding ActionText}"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    MouseLeftButtonUp="ToolCard_MouseLeftButtonUp"
                                                    KeyDown="ToolCard_KeyDown">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding ToolIcon}"
                                                                       FontFamily="Segoe Fluent Icons" FontSize="18"
                                                                       Margin="0,0,10,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource IconBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Tool.Name}" FontSize="14" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                                        </Grid>
                                                        <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Click="FavoriteTool_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FavoriteStarButtonStyle}">
                                                                    <Setter Property="ToolTip" Value="{loc:Loc Tools:Favorite}"/>
                                                                    <Setter Property="AutomationProperties.Name" Value="{loc:Loc Tools:AddToFavorites}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tool.IsFavorite}" Value="True">
                                                                            <Setter Property="ToolTip" Value="{loc:Loc Tools:Unfavorite}"/>
                                                                            <Setter Property="AutomationProperties.Name" Value="{loc:Loc Tools:RemoveFromFavorites}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock FontSize="16">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="☆"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource IconSecondaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Tool.IsFavorite}" Value="True">
                                                                                <Setter Property="Text" Value="★"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Tool.Description}" FontSize="11" TextWrapping="Wrap"
                                                               LineHeight="14" Margin="0,0,0,12" MaxHeight="42"
                                                               TextTrimming="WordEllipsis"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding ActionIcon}" FontFamily="Segoe Fluent Icons" FontSize="12"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource IconBrush}"/>
                                                        <TextBlock Text="{Binding ActionText}" FontSize="10" Margin="4,0,8,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                        <Button Click="EditTool_Click" ToolTip="{loc:Loc Tools:EditCustomTool}"
                                                                AutomationProperties.Name="{Binding EditAutomationName}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ToolActionButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tool.IsCustom}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                                                        </Button>
                                                        <Button Click="DeleteTool_Click" ToolTip="{loc:Loc Tools:DeleteCustomTool}"
                                                                AutomationProperties.Name="{Binding DeleteAutomationName}" Margin="4,0,0,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ToolActionButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tool.IsCustom}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                                                        </Button>
                                                        <Button Click="UninstallTool_Click" ToolTip="{loc:Loc Tools:Uninstall}"
                                                                AutomationProperties.Name="{Binding UninstallAutomationName}"
                                                                Tag="{Binding ElementName=ToolCard}" Margin="6,0,0,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ToolActionButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tool.WingetId}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="LoadErrorText" Text="{loc:Loc Tools:LoadToolsFailed}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>
        </Grid>

        <Border x:Name="ProgressPanel" Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}"
                BorderThickness="0,1,0,0" Padding="20,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ProgressText" Text="{loc:Loc Tools:ExternalToolsPageDownloading}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,0,6"/>
                <ProgressBar x:Name="ProgressBar" Height="4"
                             Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                             Foreground="{DynamicResource AccentBrush}"
                             Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
