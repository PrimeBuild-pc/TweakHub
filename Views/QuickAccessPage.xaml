<Page x:Class="TweakHub.Views.QuickAccessPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:TweakHub.Localization"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{loc:Loc Tools:QuickAccessPageQuickAccess}"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="ShortcutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="68"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileButtonStyle" TargetType="Button" BasedOn="{StaticResource ShortcutButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="MinHeight" Value="84"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <Grid Margin="32,24,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{loc:Loc Tools:QuickAccessPageQuickAccess2}" Style="{StaticResource PageHeadingTextStyle}" Margin="0,0,0,6"/>
            <TextBlock Text="{loc:Loc Tools:QuickAccessPageQuickShortcutsToWindowsControl}" Style="{StaticResource PageSubtitleTextStyle}"/>
            <TextBox x:Name="SearchBox" Width="320" HorizontalAlignment="Left" Margin="0,16,0,0"
                     Style="{StaticResource FieldInputStyle}"
                     ui:ControlHelper.PlaceholderText="{loc:Loc Tools:SearchShortcuts}"
                     AutomationProperties.Name="{loc:Loc Tools:SearchShortcuts}"
                     TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
            <StackPanel>
            <StackPanel x:Name="FrequentPanel">
                <TextBlock Text="{loc:Loc Tools:FrequentlyUsedShortcuts}" Style="{StaticResource CategoryHeaderStyle}" Margin="0,12,0,8"/>
                <ItemsControl x:Name="FrequentControl" Margin="0,0,-8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButtonStyle}" Click="Tile_Click"
                                    AutomationProperties.Name="{Binding Shortcut.Name}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                               Margin="0,0,0,10" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource SystemControlForegroundAccentBrush}"/>
                                    <TextBlock Text="{Binding Shortcut.Name}" FontSize="14" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <ItemsControl x:Name="ShortcutsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource CategoryHeaderStyle}" Margin="0,12,0,8"/>
                            <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ShortcutButtonStyle}"
                                                Click="Shortcut_Click"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Normal"
                                                               Margin="0,0,0,3" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" LineHeight="16"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                           VerticalAlignment="Center" Margin="16,0,0,0"
                                                           Foreground="{DynamicResource IconSecondaryBrush}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="NoResultsText" Grid.Row="1" Text="{loc:Loc Tools:NoShortcutsFound}" Margin="0,24,0,0"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Visibility="Collapsed"/>

        <TextBlock x:Name="LoadErrorText" Grid.Row="1"
                   Text="{loc:Loc Tools:LoadShortcutsFailed}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource DangerBrush}"
                   Visibility="Collapsed"/>
    </Grid>
</Page>
