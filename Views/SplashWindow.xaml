<Window x:Class="TweakHub.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="TweakHub" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="/ico.ico" FontFamily="Segoe UI Variable Text"
        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <StackPanel Margin="32,28,32,28" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal">
            <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource SubtleFillBrush}"
                    BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1">
                <Image Source="/ico.ico" Width="32" Height="32"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="TweakHub" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource CardStyle}" Margin="0,22,0,18" Padding="16,10">
            <ItemsControl x:Name="StepsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:ProgressRing Width="16" Height="16" HorizontalAlignment="Left" IsActive="{Binding IsRunning}"/>
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Elapsed}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ProgressBar x:Name="Progress" Height="4" Maximum="1"/>
        <TextBlock x:Name="StatusText" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
    </StackPanel>
</Window>
