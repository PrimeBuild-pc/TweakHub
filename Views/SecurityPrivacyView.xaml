<UserControl x:Class="TweakHub.Views.SecurityPrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TweakHub.Localization"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CardIconStyle" TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="Foreground" Value="{DynamicResource IconBrush}"/>
            </Style>
            <Style x:Key="DifficultyBadgeStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="Background" Value="{DynamicResource SystemControlBorderBaseMediumBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Difficulty}" Value="Easy">
                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Difficulty}" Value="Medium">
                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Difficulty}" Value="Hard">
                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,12,0">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Breached password -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE8D7;" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="{loc:Loc Security:PasswordTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Security:PasswordDescription}" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,12"/>
                        <DockPanel>
                            <Button x:Name="PasswordCheckButton" DockPanel.Dock="Right" Click="CheckPassword_Click"
                                    Style="{StaticResource ModernButtonStyle}" Margin="8,0,0,0" Content="{loc:Loc Security:PasswordCheck}"/>
                            <PasswordBox x:Name="PasswordInput" KeyDown="PasswordInput_KeyDown"
                                         ui:ControlHelper.PlaceholderText="{loc:Loc Security:PasswordPlaceholder}"
                                         AutomationProperties.Name="{loc:Loc Security:PasswordPlaceholder}"/>
                        </DockPanel>
                        <StackPanel x:Name="PasswordResult" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="PasswordResultIcon" Style="{StaticResource IconTextStyle}" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock x:Name="PasswordResultText" Style="{StaticResource ValueTextStyle}" MaxWidth="440"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- DNS -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE774;" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="{loc:Loc Security:DnsTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Security:DnsDescription}" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="DnsAdaptersList" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Alias}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ServersText}" Style="{StaticResource ValueTextStyle}" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <ComboBox x:Name="DnsPresetBox" Width="230" Margin="0,0,8,8" SelectionChanged="DnsPreset_SelectionChanged"
                                      AutomationProperties.Name="{loc:Loc Security:DnsTitle}"/>
                            <TextBox x:Name="CustomDnsInput" Width="200" Margin="0,0,8,8" Visibility="Collapsed"
                                     ui:ControlHelper.PlaceholderText="{loc:Loc Security:DnsCustomPlaceholder}"
                                     AutomationProperties.Name="{loc:Loc Security:DnsCustomPlaceholder}"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button x:Name="DnsTestButton" Click="TestDns_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                    Content="{loc:Loc Security:DnsTest}"/>
                            <Button x:Name="DnsApplyButton" Click="ApplyDns_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,8"
                                    ToolTip="{loc:Loc Security:RequiresAdministrator}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{loc:Loc Security:DnsApply}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DnsRestoreButton" Click="RestoreDns_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                    ToolTip="{loc:Loc Security:RequiresAdministrator}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7A7;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{loc:Loc Security:DnsRestore}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="DnsStatusText" Style="{StaticResource DescriptionTextStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Account deletion -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="{loc:Loc Security:AccountsTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        </StackPanel>
                        <Button x:Name="AccountsLoadButton" HorizontalAlignment="Right" Click="LoadAccounts_Click" Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="AccountsLoadText" Text="{loc:Loc Security:AccountsLoad}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{loc:Loc Security:AccountsDescription}" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="AccountsStatusText" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,8"/>
                    <Grid x:Name="AccountsPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{loc:Loc Security:AccountsDifficulty}" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,10"/>
                            <StackPanel x:Name="DifficultyChart"/>
                            <TextBlock Text="{loc:Loc Security:ChartFilterHint}" Style="{StaticResource DescriptionTextStyle}" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="AccountSearch" Margin="0,0,0,10" TextChanged="AccountSearch_TextChanged"
                                     ui:ControlHelper.PlaceholderText="{loc:Loc Security:AccountsSearch}"
                                     AutomationProperties.Name="{loc:Loc Security:AccountsSearch}"/>
                            <ItemsControl x:Name="AccountsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                                        <Border Style="{StaticResource DifficultyBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DifficultyText}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource DescriptionTextStyle}" FontSize="11" Margin="0,2,0,0"
                                                               MaxHeight="54" TextTrimming="WordEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Click="OpenAccount_Click" Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="12,0,0,0" VerticalAlignment="Center" Content="{loc:Loc Security:AccountsOpen}"
                                                        IsEnabled="{Binding HasUrl}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AccountsMoreText" Style="{StaticResource DescriptionTextStyle}" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Metadata -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="&#xE8EC;" Style="{StaticResource CardIconStyle}"/>
                        <TextBlock Text="{loc:Loc Security:MetadataTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Security:MetadataDescription}" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button x:Name="ExifInstallButton" Click="InstallExifTool_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc Security:MetadataInstall}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MetadataPickButton" Click="PickMetadataFile_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc Security:MetadataPick}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MetadataRemoveButton" Click="RemoveMetadata_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc Security:MetadataRemove}"/>
                            </StackPanel>
                        </Button>
                        <ui:ProgressRing x:Name="MetadataBusy" Width="20" Height="20" IsActive="False" VerticalAlignment="Top" Margin="4,6,0,0"/>
                    </WrapPanel>
                    <TextBlock x:Name="MetadataStatusText" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="MetadataGrid" Style="{StaticResource TriageGridStyle}" MaxHeight="360" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconTextStyle}" FontSize="13" Foreground="{DynamicResource WarningBrush}"
                                                   ToolTip="{loc:Loc Security:MetadataSensitive}">
                                            <TextBlock.Visibility>
                                                <Binding Path="Sensitive">
                                                    <Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter>
                                                </Binding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Security:MetadataGroup}" Binding="{Binding Group}" Width="Auto"/>
                            <DataGridTextColumn Header="{loc:Loc Security:MetadataTag}" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTemplateColumn Header="{loc:Loc Security:MetadataValue}" Width="4*" SortMemberPath="Value">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value}" ToolTip="{Binding Value}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
