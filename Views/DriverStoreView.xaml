<UserControl x:Class="TweakHub.Views.DriverStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TweakHub.Localization">
    <UserControl.Resources><ResourceDictionary Source="SectionStyles.xaml"/></UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,12,0">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Devices:DriversTitle}" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{loc:Loc Devices:DriversDescription}" Style="{StaticResource DescriptionTextStyle}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="ScanButton" Content="{loc:Loc Devices:DriversScan}" Click="Scan_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,6"/>
                        <Button x:Name="RemoveButton" Content="{loc:Loc Devices:DriversRemove}" Click="Remove_Click" Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource DescriptionTextStyle}" Margin="0,6,0,0"/>
                    <DataGrid x:Name="PackagesGrid" Style="{StaticResource TriageGridStyle}" MaxHeight="420" Margin="0,10,0,0" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Security:ColumnName}" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:DriversColumnProvider}" Binding="{Binding Provider}" Width="2*"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:ColumnClass}" Binding="{Binding Class}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:DriversColumnVersion}" Binding="{Binding Version}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:DriversColumnNewer}" Binding="{Binding NewerVersion}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Devices:DriversColumnDate}" Binding="{Binding Date}" Width="*"/>
                            <DataGridTextColumn Header="INF" Binding="{Binding Inf}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Devices:DriversBackups}" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock x:Name="NoBackupsText" Text="{loc:Loc Devices:DriversNoBackups}" Style="{StaticResource DescriptionTextStyle}"/>
                    <ItemsControl x:Name="BackupsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource DescriptionTextStyle}" FontSize="11">
                                            <Run Text="{Binding Inf, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding RemovedText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{loc:Loc Devices:DriversRestore}" Click="Restore_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
