<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="LabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="IconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CheckIconStyle" TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Text" Value="&#xE9CE;"/>
        <Setter Property="Foreground" Value="{DynamicResource IconSecondaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Passed">
                <Setter Property="Text" Value="&#xE73E;"/>
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Failed">
                <Setter Property="Text" Value="&#xE7BA;"/>
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Status}" Value="Failed"/>
                    <Condition Binding="{Binding Weight}" Value="3"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Text" Value="&#xEA39;"/>
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Trust of a file behind a connection or startup entry. -->
    <Style x:Key="TrustIconStyle" TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Text" Value="&#xE9CE;"/>
        <Setter Property="Foreground" Value="{DynamicResource IconSecondaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Trust}" Value="Signed">
                <Setter Property="Text" Value="&#xEA18;"/>
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Trust}" Value="Unsigned">
                <Setter Property="Text" Value="&#xEA39;"/>
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Trust}" Value="ScriptHost">
                <Setter Property="Text" Value="&#xE7BA;"/>
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Trust}" Value="Missing">
                <Setter Property="Text" Value="&#xE7BA;"/>
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SmallIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PreviewIconButtonStyle}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Margin" Value="2,0"/>
    </Style>

    <Style x:Key="TileValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    </Style>

    <Style x:Key="TriageGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MaxHeight" Value="420"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="MinRowHeight" Value="30"/>
    </Style>
</ResourceDictionary>
