<Window x:Class="TweakHub.Views.Dialogs.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Text"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <!-- Caption-less but still a captioned window to DWM: native shadow and Windows 11 rounded corners. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,24,24,22" Background="Transparent" MouseLeftButtonDown="Body_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,16,0" VerticalAlignment="Top"
                    Background="{DynamicResource SubtleFillBrush}">
                <TextBlock x:Name="IconText" FontFamily="Segoe Fluent Icons" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <TextBlock x:Name="MessageText" FontSize="14" LineHeight="20" TextWrapping="Wrap"/>
                </ScrollViewer>
                <TextBox x:Name="InputBox" Visibility="Collapsed" Margin="0,14,0,0"/>
                <StackPanel x:Name="ChoicePanel" Visibility="Collapsed" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="24" BorderThickness="0,1,0,0"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PrimaryButton" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch"
                        IsDefault="True" Click="Primary_Click"/>
                <Button x:Name="SecondaryButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
