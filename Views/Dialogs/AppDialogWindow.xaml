<Window x:Class="TweakHub.Views.Dialogs.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Text"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <!-- Caption-less but still a captioned window to DWM: native shadow and Windows 11 rounded corners. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,24,24,12" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconText" FontFamily="{StaticResource FluentIconFont}" FontSize="22" Margin="0,0,12,0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                       VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
        </Grid>

        <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="24,0,16,22"
                      Padding="0,0,8,0">
            <StackPanel>
                <TextBlock x:Name="MessageText" FontSize="14" FontWeight="Normal" LineHeight="20" TextWrapping="Wrap"/>
                <TextBox x:Name="InputBox" Style="{StaticResource FieldInputStyle}" Visibility="Collapsed" Margin="0,14,0,0"/>
                <StackPanel x:Name="ChoicePanel" Visibility="Collapsed" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PrimaryButton" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch"
                        MinHeight="34" IsDefault="True" Click="Primary_Click">
                    <Button.ContentTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button x:Name="SecondaryButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch" MinHeight="34" IsCancel="True"
                        ContentTemplate="{Binding ContentTemplate, ElementName=PrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
