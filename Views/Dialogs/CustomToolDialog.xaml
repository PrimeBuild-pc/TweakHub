<Window x:Class="TweakHub.Views.Dialogs.CustomToolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom External Tool" Width="620" Height="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Custom external tool" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Create a reusable website, Winget or PowerShell card. PowerShell runs only after confirmation."
                       Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Name" Margin="0,0,0,4"/>
                <TextBox x:Name="NameTextBox" MaxLength="100" Margin="0,0,0,12"/>

                <TextBlock Text="Description" Margin="0,0,0,4"/>
                <TextBox x:Name="DescriptionTextBox" MaxLength="500" Height="64" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                <TextBlock Text="Category" Margin="0,0,0,4"/>
                <ComboBox x:Name="CategoryComboBox" IsEditable="True" Margin="0,0,0,12"/>

                <TextBlock Text="Action" Margin="0,0,0,4"/>
                <ComboBox x:Name="ActionComboBox" SelectedValuePath="Tag" SelectionChanged="ActionType_Changed" Margin="0,0,0,12">
                    <ComboBoxItem Content="Open HTTPS website or online file" Tag="Website"/>
                    <ComboBoxItem Content="Install exact Winget package ID" Tag="Winget"/>
                    <ComboBoxItem Content="Run PowerShell command" Tag="PowerShell"/>
                </ComboBox>

                <TextBlock x:Name="ActionValueLabel" Text="Value" Margin="0,0,0,4"/>
                <TextBox x:Name="ActionValueTextBox" MaxLength="8192" Height="88" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                <TextBlock x:Name="ActionHelpText" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <CheckBox x:Name="RequiresAdministratorCheckBox" Content="Request administrator privileges"
                          Margin="0,12,0,0"/>
                <TextBlock x:Name="ValidationText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button x:Name="SaveToolButton" Content="Save tool" Style="{StaticResource ModernButtonStyle}" Width="110"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
