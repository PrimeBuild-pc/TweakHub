<Window x:Class="TweakHub.Views.Dialogs.CustomToolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TweakHub.Localization"
        Title="{loc:Loc Tools:CustomToolDialogCustomExternalTool}" Width="600" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,14">
            <TextBlock Text="{loc:Loc Tools:CustomToolDialogCustomExternalTool2}" Style="{StaticResource DialogHeadingTextStyle}"/>
            <TextBlock Text="{loc:Loc Tools:CustomToolDialogCreateAReusableWebsiteWinget}"
                       Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,18">
            <StackPanel>
                <TextBlock x:Name="NameLabel" Text="{loc:Loc Tools:CustomToolDialogName}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="NameTextBox" Style="{StaticResource FieldInputStyle}" MaxLength="100" Margin="0,0,0,12"
                         AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"/>

                <TextBlock x:Name="DescriptionLabel" Text="{loc:Loc Tools:CustomToolDialogDescription}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="DescriptionTextBox" Style="{StaticResource FieldMultilineStyle}" MaxLength="500" Height="64" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                         AutomationProperties.LabeledBy="{Binding ElementName=DescriptionLabel}"/>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="CategoryLabel" Text="{loc:Loc Tools:CustomToolDialogCategory}" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CategoryComboBox" Style="{StaticResource FluentDropDownStyle}" HorizontalAlignment="Stretch" IsEditable="True" Margin="0,0,0,12"
                                  AutomationProperties.LabeledBy="{Binding ElementName=CategoryLabel}"/>

                        <TextBlock x:Name="ActionLabel" Text="{loc:Loc Tools:CustomToolDialogAction}" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="ActionComboBox" Style="{StaticResource FluentDropDownStyle}" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectionChanged="ActionType_Changed" Margin="0,0,0,12"
                                  AutomationProperties.LabeledBy="{Binding ElementName=ActionLabel}">
                            <ComboBoxItem Content="{loc:Loc Tools:CustomToolDialogOpenHTTPSWebsiteOrOnline}" Tag="Website"/>
                            <ComboBoxItem Content="{loc:Loc Tools:CustomToolDialogInstallExactWingetPackageID}" Tag="Winget"/>
                            <ComboBoxItem Content="{loc:Loc Tools:CustomToolDialogRunPowerShellCommand}" Tag="PowerShell"/>
                        </ComboBox>

                        <TextBlock x:Name="ActionValueLabel" Text="{loc:Loc Tools:CustomToolDialogValue}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="ActionValueTextBox" Style="{StaticResource FieldMultilineStyle}" MaxLength="8192" Height="88" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ActionValueLabel}"/>
                        <TextBlock x:Name="ActionHelpText" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <CheckBox x:Name="RequiresAdministratorCheckBox" Content="{loc:Loc Tools:CustomToolDialogRequestAdministratorPrivileges}"
                                  Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ValidationText" Margin="0,12,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource DangerBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveToolButton" Content="{loc:Loc Tools:CustomToolDialogSaveTool}" Style="{StaticResource ModernButtonStyle}"
                        HorizontalAlignment="Stretch" MinHeight="34" IsDefault="True" Click="Save_Click"/>
                <Button Grid.Column="2" Content="{loc:Loc Tools:CustomToolDialogCancel}" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch" MinHeight="34" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
