<Window x:Class="TweakHub.Views.Dialogs.CustomToolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:TweakHub.Localization"
        Title="{loc:Loc Tools:CustomToolDialogCustomExternalTool}" Width="620" Height="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{loc:Loc Tools:CustomToolDialogCustomExternalTool2}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Loc Tools:CustomToolDialogCreateAReusableWebsiteWinget}"
                       Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel>
                <TextBlock Text="{loc:Loc Tools:CustomToolDialogName}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameTextBox" MaxLength="100" Margin="0,0,0,12"
                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>

                <TextBlock Text="{loc:Loc Tools:CustomToolDialogDescription}" Margin="0,0,0,4"/>
                <TextBox x:Name="DescriptionTextBox" MaxLength="500" Height="64" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>

                <TextBlock Text="{loc:Loc Tools:CustomToolDialogCategory}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CategoryComboBox" IsEditable="True" Margin="0,0,0,12"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>

                <TextBlock Text="{loc:Loc Tools:CustomToolDialogAction}" Margin="0,0,0,4"/>
                <ComboBox x:Name="ActionComboBox" SelectedValuePath="Tag" SelectionChanged="ActionType_Changed" Margin="0,0,0,12"
                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
                    <ComboBoxItem Content="{loc:Loc Tools:CustomToolDialogOpenHTTPSWebsiteOrOnline}" Tag="Website"/>
                    <ComboBoxItem Content="{loc:Loc Tools:CustomToolDialogInstallExactWingetPackageID}" Tag="Winget"/>
                    <ComboBoxItem Content="{loc:Loc Tools:CustomToolDialogRunPowerShellCommand}" Tag="PowerShell"/>
                </ComboBox>

                <TextBlock x:Name="ActionValueLabel" Text="{loc:Loc Tools:CustomToolDialogValue}" Margin="0,0,0,4"/>
                <TextBox x:Name="ActionValueTextBox" MaxLength="8192" Height="88" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                <TextBlock x:Name="ActionHelpText" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <CheckBox x:Name="RequiresAdministratorCheckBox" Content="{loc:Loc Tools:CustomToolDialogRequestAdministratorPrivileges}"
                          Margin="0,12,0,0"/>
                <TextBlock x:Name="ValidationText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:Loc Tools:CustomToolDialogCancel}" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button x:Name="SaveToolButton" Content="{loc:Loc Tools:CustomToolDialogSaveTool}" Style="{StaticResource ModernButtonStyle}" Width="110"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
