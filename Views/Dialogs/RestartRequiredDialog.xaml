<Window x:Class="TweakHub.Views.Dialogs.RestartRequiredDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Restart Required"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text"
        Background="{DynamicResource WindowBackgroundBrush}"
        Width="520"
        SizeToContent="Height">

    <Border CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons" FontSize="30" Margin="0,0,14,0" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Restart Required" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="0,0,0,22">
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           FontSize="15"
                           Opacity="0.95"
                           Text="A system restart is required for the changes to take effect."/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           FontSize="13"
                           Opacity="0.7"
                           Margin="0,10,0,0"
                           Text="This message is shown once per session."/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="140" Height="40"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="{DynamicResource AccentBrush}"
                        Click="OkButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" Foreground="White"/>
                        <TextBlock Text="OK" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
