<Window x:Class="TweakHub.Views.Dialogs.ScriptEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TweakHub.Localization"
        Width="640" Height="560" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>

        <TextBox x:Name="NameTextBox" Grid.Row="1" MaxLength="100" Margin="0,0,0,12"
                 ToolTip="{loc:Loc Scripts:EnterScriptName}" AutomationProperties.Name="{loc:Loc Scripts:EnterScriptName}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="PowerShellRadio" Content="PowerShell" Margin="0,0,12,0"/>
            <RadioButton x:Name="CmdRadio" Content="{loc:Loc Scripts:CmdBatch}" Margin="0,0,20,0"/>
            <CheckBox x:Name="AdminCheckBox" Content="{loc:Loc Scripts:RequiresAdministrator}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBox x:Name="ContentTextBox" Grid.Row="3" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" VerticalContentAlignment="Top"/>

        <TextBlock x:Name="ValidationText" Grid.Row="4" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:Loc Scripts:Cancel}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="96" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="SaveButton" Style="{StaticResource ModernButtonStyle}" MinWidth="100" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
