<Window x:Class="TweakHub.Views.Dialogs.GhostDevicesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TweakHub.Localization"
        Title="{loc:Loc Devices:RemoveGhosts}" Width="760" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Text"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <!-- Same chrome as AppDialogWindow: caption-less, native shadow and rounded corners. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,24,24,18" Background="Transparent" MouseLeftButtonDown="Body_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,14,0" Background="{DynamicResource SubtleFillBrush}">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{DynamicResource WarningBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{loc:Loc Devices:RemoveGhosts}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

            <Grid Margin="0,16,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="FilterBox" VerticalAlignment="Center" IsChecked="True" Content="{loc:Loc Devices:GhostHideRecent}"
                              Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <TextBox x:Name="FilterDaysBox" Width="52" Margin="8,0" VerticalAlignment="Center" TextChanged="Filter_Changed"/>
                    <TextBlock Text="{loc:Loc Devices:GhostHideRecentDays}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="SelectedText" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </Grid>

            <Border CornerRadius="8" BorderThickness="1" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}">
                <DockPanel>
                    <!-- Column headings; rows use the same widths. -->
                    <Grid DockPanel.Dock="Top" Margin="40,12,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Devices:GhostColumnDevice}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Devices:GhostColumnLastUsed}" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Grid>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RowsPanel" Margin="12,0,12,8"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Padding="24" BorderThickness="0,1,0,0"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RemoveButton" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch"
                        IsDefault="True" Click="Remove_Click"/>
                <Button Grid.Column="2" Content="{loc:Loc UI:Cancel}" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
