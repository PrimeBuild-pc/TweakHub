<Window x:Class="TweakHub.Views.Dialogs.CustomTweakDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TweakHub.Localization"
        Width="568" SizeToContent="Height" MaxHeight="720" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}"
        FontFamily="Segoe UI Variable Text" FontSize="13"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" Style="{StaticResource DialogHeadingTextStyle}" Margin="24,20,24,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,18">
            <StackPanel>
                <TextBlock x:Name="NameLabel" Text="{loc:Loc Tweaks:Name}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="NameTextBox" MaxLength="100" Margin="0,0,0,12" Style="{StaticResource FieldInputStyle}"
                         AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"/>

                <TextBlock x:Name="DescriptionLabel" Text="{loc:Loc Tweaks:Description}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="DescriptionTextBox" MaxLength="500" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,0,0,16"
                         Style="{StaticResource FieldMultilineStyle}"
                         AutomationProperties.LabeledBy="{Binding ElementName=DescriptionLabel}"/>

                <Border Style="{StaticResource SettingsCardStyle}" CornerRadius="5">
                    <StackPanel>
                        <TextBlock x:Name="PathLabel" Text="{loc:Loc Tweaks:RegistryPathLabel}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="PathTextBox" FontFamily="Consolas" Margin="0,0,0,12" Style="{StaticResource FieldInputStyle}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=PathLabel}"/>

                        <TextBlock x:Name="ValueNameLabel" Text="{loc:Loc Tweaks:ValueName}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="ValueNameTextBox" Margin="0,0,0,12" Style="{StaticResource FieldInputStyle}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ValueNameLabel}"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TypeLabel" Text="{loc:Loc Tweaks:Type}" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="TypeComboBox" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                          Style="{StaticResource FluentDropDownStyle}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=TypeLabel}">
                                    <ComboBoxItem Content="REG_SZ" Tag="REG_SZ"/>
                                    <ComboBoxItem Content="REG_DWORD (32-bit)" Tag="REG_DWORD"/>
                                    <ComboBoxItem Content="REG_QWORD (64-bit)" Tag="REG_QWORD"/>
                                    <ComboBoxItem Content="REG_BINARY" Tag="REG_BINARY"/>
                                    <ComboBoxItem Content="REG_MULTI_SZ" Tag="REG_MULTI_SZ"/>
                                    <ComboBoxItem Content="REG_EXPAND_SZ" Tag="REG_EXPAND_SZ"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="RiskLabel" Text="{loc:Loc Tweaks:RiskLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="RiskComboBox" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                          Style="{StaticResource FluentDropDownStyle}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=RiskLabel}">
                                    <ComboBoxItem Content="{loc:Loc Tweaks:RiskSafe}" ToolTip="{loc:Loc Tweaks:RiskSafeHint}" Tag="Safe"/>
                                    <ComboBoxItem Content="{loc:Loc Tweaks:RiskCosmetic}" ToolTip="{loc:Loc Tweaks:RiskCosmeticHint}" Tag="Cosmetic"/>
                                    <ComboBoxItem Content="{loc:Loc Tweaks:RiskModerate}" ToolTip="{loc:Loc Tweaks:RiskModerateHint}" Tag="Moderate"/>
                                    <ComboBoxItem Content="{loc:Loc Tweaks:RiskCaution}" ToolTip="{loc:Loc Tweaks:RiskCautionHint}" Tag="Caution"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="DataLabel" Text="{loc:Loc Tweaks:Value}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="DataTextBox" FontFamily="Consolas" Style="{StaticResource FieldInputStyle}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=DataLabel}"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidationText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveButton" Style="{StaticResource ModernButtonStyle}" MinHeight="34"
                        HorizontalAlignment="Stretch" IsDefault="True" Click="Save_Click"/>
                <Button Grid.Column="2" Content="{loc:Loc Tweaks:Cancel}" Style="{StaticResource SecondaryButtonStyle}"
                        MinHeight="34" HorizontalAlignment="Stretch" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
