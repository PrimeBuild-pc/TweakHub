<Page x:Class="TweakHub.Views.RegistryTweaksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Registry Tweaks"
      Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PaddedTabControl" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ModernTabItem" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TweakItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <DataTemplate x:Key="FavoriteStarTemplate">
            <TextBlock FontSize="18">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="☆"/>
                        <Setter Property="Foreground" Value="{DynamicResource IconSecondaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter Property="Text" Value="★"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="BuiltInTweakTemplate">
            <Border Style="{StaticResource TweakItemStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE814;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                       Margin="0,0,10,0" Foreground="{DynamicResource WarningBrush}"
                                       Visibility="{Binding IsPartiallyApplied, Converter={StaticResource BoolToVis}}"
                                       ToolTip="Only part of this grouped tweak is currently applied"/>
                            <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                       Margin="0,0,10,0" Foreground="{DynamicResource WarningBrush}"
                                       Visibility="{Binding IsRestartPending, Converter={StaticResource BoolToVis}}"
                                       ToolTip="Restart Windows to make this change fully effective"/>
                            <Button Style="{StaticResource FavoriteStarButtonStyle}" Margin="0,0,8,0"
                                    Click="FavoriteTweak_Click" ToolTip="Add or remove from favorites"
                                    AutomationProperties.Name="Toggle favorite" Content="{Binding}"
                                    ContentTemplate="{StaticResource FavoriteStarTemplate}"/>
                            <ui:ToggleSwitch IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                             OffContent="{x:Null}" OnContent="{x:Null}"
                                             VerticalAlignment="Center" Margin="0,0,12,0"
                                             Tag="{Binding}" AutomationProperties.Name="Enable tweak"
                                             Toggled="TweakToggle_Toggled"/>
                            <Button Style="{StaticResource PreviewIconButtonStyle}"
                                    Click="ViewTweak_Click" AutomationProperties.Name="Preview registry changes"
                                    Tag="{Binding}" ToolTip="Preview registry changes">
                                <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                           Foreground="{DynamicResource IconBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}"
                            Margin="0,12,0,0" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <TextBlock Text="{Binding PreviewContent}" FontFamily="Consolas" FontSize="13"
                                   Margin="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CustomTweakTemplate">
            <Border Style="{StaticResource TweakItemStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Medium"/>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="8,0,0,0"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}"
                                           ToolTip="This Registry value currently matches the custom tweak"/>
                            </StackPanel>
                            <TextBlock Margin="16,0,0,0" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                                <Run Text="{Binding RegistryPath}"/><Run Text="\"/><Run Text="{Binding RegistryKey}"/>
                            </TextBlock>
                            <TextBlock Margin="16,2,0,0" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                                <Run Text="{Binding ValueType}"/><Run Text=": "/><Run Text="{Binding Data}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource FavoriteStarButtonStyle}" Margin="0,0,8,0"
                                    Click="FavoriteTweak_Click" ToolTip="Add or remove from favorites"
                                    AutomationProperties.Name="Toggle favorite" Content="{Binding}"
                                    ContentTemplate="{StaticResource FavoriteStarTemplate}"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                    Click="ViewCustomTweak_Click" Tag="{Binding ElementName=CustomPreviewPanel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/>
                                    <TextBlock Text="View"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ExecuteButtonStyle}" Margin="0,0,8,0" Click="ApplyCustomTweak_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/>
                                    <TextBlock Text="Apply"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="RestoreCustomTweak_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/>
                                    <TextBlock Text="Restore"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="EditCustomTweak_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/>
                                    <TextBlock Text="Edit"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButtonStyle}" Click="DeleteCustomTweak_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/>
                                    <TextBlock Text="Delete"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="CustomPreviewPanel" Tag="{Binding ElementName=CustomPreviewText}"
                            Margin="0,12,0,0" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="150"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Details" FontWeight="SemiBold" Margin="12,8,12,4"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <Border Grid.Row="1" Margin="12" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="CustomPreviewText" IsReadOnly="True" TextWrapping="Wrap"
                                             FontFamily="Consolas" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                             SelectionBrush="{DynamicResource AccentBrush}"
                                             SelectionTextBrush="{DynamicResource AccentForegroundBrush}"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Registry Tweaks" FontSize="28" FontWeight="Light"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Optimize Windows performance through registry modifications. Changes are automatically backed up."
                           FontSize="12" LineHeight="18"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding LastBackupStatusText}" FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       VerticalAlignment="Top" Margin="0,6,0,0"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,24">
            <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButtonStyle}"
                    Click="RefreshButton_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh Status" FontSize="11"/>
                </StackPanel>
            </Button>
            <Button x:Name="BackupButton" Style="{StaticResource SecondaryButtonStyle}"
                    Click="BackupButton_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock Text="Create Backup" FontSize="11"/>
                </StackPanel>
            </Button>
            <Button x:Name="CreateRestorePointButton" Style="{StaticResource SecondaryButtonStyle}"
                    Click="CreateRestorePointButton_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE83D;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock Text="Create Restore Point" FontSize="11"/>
                </StackPanel>
            </Button>
            <Button x:Name="ApplyAllButton" Style="{StaticResource PrimaryActionButtonStyle}"
                    Click="ApplyAllButton_Click" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"
                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                    <TextBlock Text="Apply Recommended" FontSize="11"/>
                </StackPanel>
            </Button>
            <Button x:Name="RestoreAllButton" Style="{StaticResource DangerButtonStyle}"
                    Click="RestoreAllButton_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0"
                               Foreground="{DynamicResource DangerForegroundBrush}"/>
                    <TextBlock Text="Restore All Changes" FontSize="11"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="2">
            <TabControl Style="{StaticResource PaddedTabControl}" ItemContainerStyle="{StaticResource ModernTabItem}">
                <TabItem Header="Recommended">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,16,0">
                        <ItemsControl x:Name="TweakCategoriesControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,32">
                                        <Border Margin="0,0,0,12" CornerRadius="8" Padding="16,12" BorderThickness="1"
                                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="20"
                                                               Margin="0,0,12,0" Foreground="{DynamicResource IconBrush}"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Tweaks}" ItemTemplate="{StaticResource BuiltInTweakTemplate}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Custom Tweaks">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                        <StackPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                                       Margin="0,0,8,0" Foreground="{DynamicResource IconBrush}"/>
                                            <TextBlock Text="Custom Registry Tweaks" Style="{StaticResource CategoryHeaderStyle}"/>
                                        </StackPanel>
                                        <TextBlock Text="Create and manage your own registry entries."
                                                   Style="{StaticResource DescriptionTextStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}"
                                            Click="AddCustomTweak_Click" MinWidth="140" Padding="16,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                       Margin="0,0,8,0" Foreground="{DynamicResource AccentForegroundBrush}"/>
                                            <TextBlock Text="New Tweak"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="CustomTweaksList" ItemTemplate="{StaticResource CustomTweakTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Favorites">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,16,0">
                        <StackPanel>
                            <TextBlock x:Name="FavoritesEmptyText" Text="No favorite Registry tweaks yet. Select a star to add one."
                                       HorizontalAlignment="Center" Margin="0,32" FontSize="13"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <StackPanel x:Name="FavoriteBuiltInSection">
                                <TextBlock Text="Recommended" Style="{StaticResource CategoryHeaderStyle}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="FavoriteBuiltInTweaksList" ItemTemplate="{StaticResource BuiltInTweakTemplate}"/>
                            </StackPanel>
                            <StackPanel x:Name="FavoriteCustomSection" Margin="0,16,0,0">
                                <TextBlock Text="Custom Tweaks" Style="{StaticResource CategoryHeaderStyle}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="FavoriteCustomTweaksList" ItemTemplate="{StaticResource CustomTweakTemplate}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
