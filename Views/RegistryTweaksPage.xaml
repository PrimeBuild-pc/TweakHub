<Page x:Class="TweakHub.Views.RegistryTweaksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TweakHub.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Registry Tweaks"
      Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">

    <Page.Resources>
        <!-- Ensure text color adapts to theme, but inherits control Foreground (important for buttons in Light Mode) -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground">
                <Setter.Value>
                    <Binding Path="Foreground"
                             RelativeSource="{RelativeSource AncestorType=Control}" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Converter to toggle preview visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tab visuals: padding, spacing, contrast -->
        <Style x:Key="PaddedTabControl" TargetType="TabControl">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <TabPanel Margin="0" ClipToBounds="False"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <!-- Bookmark header row: "Sections:" + tabs on the same line -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="False" SnapsToDevicePixels="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Header (label + tabs) -->
                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="4,0,0,0" ClipToBounds="False">
                                <TextBlock Text="Sections:"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           Opacity="0.9"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0"/>
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          Background="Transparent"
                                          VerticalAlignment="Center"
                                          Margin="6,0,0,0"
                                          ClipToBounds="False"/>
                            </DockPanel>
                            <!-- Contenuto selezionato -->
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              Margin="0,12,0,0"
                                              ContentSource="SelectedContent"
                                              Focusable="False"
                                              SnapsToDevicePixels="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,8"/>
            <!-- Stronger overlap to mimic stacked bookmarks -->
            <Setter Property="Margin" Value="-10,0,10,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Panel.ZIndex" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="False">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <Border x:Name="UnderlineGlow"
                                        Height="2"
                                        Background="Transparent"
                                        VerticalAlignment="Bottom"
                                        Margin="2,0,2,-1"
                                        Opacity="0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14"
                                                          ShadowDepth="0"
                                                          Opacity="0.35"
                                                          Color="{Binding Source={StaticResource AccentBrush}, Path=Color}"/>
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="Underline"
                                        Height="2"
                                        Background="Transparent"
                                        VerticalAlignment="Bottom"
                                        Margin="2,0,2,-1"
                                        Opacity="0.60"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="False">
                                <!-- Rear shadow for non-selected bookmarks -->
                                <Setter TargetName="Root" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.10" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Panel.ZIndex" Value="3"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
                                <Setter TargetName="Underline" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="UnderlineGlow" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="UnderlineGlow" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Root" Property="Effect">
                                    <Setter.Value>
                                        <!-- Rear shadow for layered bookmark look -->
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.16" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TweakItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.08" ShadowDepth="2" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RiskLevelIndicator" TargetType="Border">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Registry Tweaks"
                           FontSize="32" FontWeight="Light"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Optimize Windows performance through registry modifications. Changes are automatically backed up."
                           FontSize="14"
                           Opacity="0.7"
                           LineHeight="20"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding LastBackupStatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Opacity="0.9"
                       VerticalAlignment="Top"
                       Margin="0,6,0,0"/>
        </Grid>

        <!-- Action Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,24">
            <!-- 1. Refresh Status - Secondary/Neutral -->
            <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButtonStyle}"
                    Click="RefreshButton_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="11" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh Status" FontSize="11"/>
                </StackPanel>
            </Button>

            <!-- 2. Create Backup - Orange/Standard -->
            <Button x:Name="BackupButton" Style="{StaticResource ModernButtonStyle}"
                    Click="BackupButton_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                    <TextBlock Text="Create Backup" FontSize="11"/>
                </StackPanel>
            </Button>

            <!-- 3. Create Restore Point - Orange/Standard -->
            <Button x:Name="CreateRestorePointButton" Style="{StaticResource ModernButtonStyle}"
                    Click="CreateRestorePointButton_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛟" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                    <TextBlock Text="Create Restore Point" FontSize="11"/>
                </StackPanel>
            </Button>

            <!-- 4. Apply Recommended - PRIMARY GREEN (Most prominent) -->
            <Button x:Name="ApplyAllButton" Style="{StaticResource PrimaryActionButtonStyle}"
                    Click="ApplyAllButton_Click" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                    <TextBlock Text="Apply Recommended" FontSize="11"/>
                </StackPanel>
            </Button>

            <!-- 5. Restore All Changes - DANGER RED -->
            <Button x:Name="RestoreAllButton" Style="{StaticResource DangerButtonStyle}"
                    Click="RestoreAllButton_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↩️" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                    <TextBlock Text="Restore All Changes" FontSize="11"/>
                </StackPanel>
            </Button>
        </StackPanel>



        <!-- Tweaks & Custom Tabs -->
        <Grid Grid.Row="2" ClipToBounds="False">
            <TabControl
                Style="{StaticResource PaddedTabControl}"
                ItemContainerStyle="{StaticResource ModernTabItem}"
                ClipToBounds="False">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Recommended"/>
                </TabItem.Header>
                <!-- Add right padding to prevent clipping of buttons at the edge -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,16,0">
                    <ItemsControl x:Name="TweakCategoriesControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,32">
                                    <Border Margin="0,0,0,12" 
                                            CornerRadius="10" 
                                            Padding="16,12"
                                            BorderThickness="1">
                                        <Border.Background>
                                            <DynamicResource ResourceKey="SystemControlBackgroundChromeMediumLowBrush"/>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <DynamicResource ResourceKey="SystemControlBorderBaseLowBrush"/>
                                        </Border.BorderBrush>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Icon}" FontSize="22" Margin="0,0,12,0" Foreground="{DynamicResource IconBrush}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Opacity="0.7" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Tweaks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TweakItemStyle}">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Column 0: Info (Title + Description) -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                           Opacity="0.7"
                                                                           Margin="0,4,0,0"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>

                                                            <!-- Column 1: Actions (Toggle + eye) -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                          IsEnabled="{Binding IsAvailable}"
                                                                          Style="{StaticResource PillToggleStyle}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,12,0"
                                                                          Tag="{Binding}"
                                                                          Click="TweakToggle_Click"/>

                                                                <Button Style="{StaticResource PreviewIconButtonStyle}"
                                                                        IsEnabled="{Binding IsAvailable}"
                                                                        Click="ViewTweak_Click"
                                                                        VerticalAlignment="Center"
                                                                        Tag="{Binding}"
                                                                        ToolTip="Preview registry changes">
                                                                    <TextBlock Text="👁" FontSize="13" Foreground="{DynamicResource IconBrush}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                        
                                                        <!-- Preview content (keep below) -->
                                                        <Border Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}" 
                                                                Margin="0,12,0,0" 
                                                                CornerRadius="8" 
                                                                BorderThickness="1" 
                                                                BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" 
                                                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                                            <TextBlock Text="{Binding PreviewContent}" 
                                                                       FontFamily="Consolas" 
                                                                       FontSize="13" 
                                                                       Margin="12" 
                                                                       TextWrapping="Wrap"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Custom Tweaks"/>
                </TabItem.Header>
                <!-- Add right padding for consistent spacing with Recommended tab -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                    <StackPanel Margin="0,16,0,0">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🧩" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource IconBrush}"/>
                                        <TextBlock Text="Custom Registry Tweaks" Style="{StaticResource CategoryHeaderStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="Create and manage your own registry entries." Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Click="AddCustomTweak_Click" MinWidth="140" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" Foreground="White"/>
                                        <TextBlock Text="New Tweak"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <ItemsControl x:Name="CustomTweaksList"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </Grid>
</Grid>
</Page>
