<Page x:Class="TweakHub.Views.RegistryTweaksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:TweakHub.Views.Controls"
      xmlns:loc="clr-namespace:TweakHub.Localization"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{loc:Loc Tweaks:RegistryTweaksPageRegistryTweaks}"
      Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TweakItemStyle" TargetType="Border" BasedOn="{StaticResource HoverSettingsCardStyle}">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>

        <Geometry x:Key="BackupIconGeometry">M 3.5,2.5 H 10.5 L 13.5,5.5 V 12.5 Q 13.5,13.5 12.5,13.5 H 3.5 Q 2.5,13.5 2.5,12.5 V 3.5 Q 2.5,2.5 3.5,2.5 Z M 5,2.5 V 6 H 10 V 2.5 M 5,13.5 V 9.5 H 11 V 13.5</Geometry>
        <Geometry x:Key="RestorePointIconGeometry">M 8,1.5 L 13,3.6 V 7.4 C 13,10.5 11.3,12.8 8,14.5 C 4.7,12.8 3,10.5 3,7.4 V 3.6 Z M 8,5 V 10.5 M 5.25,7.75 H 10.75</Geometry>
        <Geometry x:Key="CheckIconGeometry">M 3,8 L 6.5,11.5 13,4.5</Geometry>
        <Geometry x:Key="HistoryIconGeometry">M 2.5,7.5 A 5.5,5.5 0 1 1 3.7,11.5 M 2.5,3.5 V 7.5 H 6.5 M 8,5 V 8 L 10.2,9.25</Geometry>

        <Style x:Key="RegistryGroupHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource CategoryHeaderStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
        </Style>

        <Style x:Key="RiskExplanationLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource FluentAccentTextBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TweakDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource DescriptionTextStyle}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TweakCommandSurfaceStyle" TargetType="Border" BasedOn="{StaticResource CommandPreviewSurfaceStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PreviewContent}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="BuiltInTweakTemplate">
            <Border Style="{StaticResource TweakItemStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontSize="14" TextWrapping="Wrap">
                            <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  ·&#x00A0;"/><Hyperlink
                                Style="{StaticResource RiskExplanationLinkStyle}" FontSize="12" ToolTip="{Binding RiskHint}"
                                Click="RiskExplanation_Click"><Run Text="{Binding RiskText, Mode=OneWay}"/></Hyperlink>
                        </TextBlock>
                        <StackPanel x:Name="RowActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE814;" FontFamily="{StaticResource FluentIconFont}" FontSize="14"
                                       Margin="0,0,10,0" Foreground="{DynamicResource WarningBrush}"
                                       Visibility="{Binding IsPartiallyApplied, Converter={StaticResource BoolToVis}}"
                                       ToolTip="{loc:Loc Tweaks:RegistryTweaksPageOnlyPartOfThisGrouped}"/>
                            <Button Style="{StaticResource FavoriteStarButtonStyle}" Width="32" MinHeight="32" Margin="0,0,4,0"
                                    Click="FavoriteTweak_Click" ToolTip="{loc:Loc Tweaks:RegistryTweaksPageAddOrRemoveFromFavorites}"
                                    AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPageToggleFavorite}" Content="{Binding}"
                                    ContentTemplate="{StaticResource FavoriteStarTemplate}"/>
                            <Button Style="{StaticResource CommandPreviewButtonStyle}" Margin="0,0,12,0"
                                    Click="ViewTweak_Click" AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPagePreviewRegistryChanges}"
                                    Content="{Binding}" ToolTip="{loc:Loc Tweaks:RegistryTweaksPagePreviewRegistryChanges2}"/>
                            <!-- The handler disables the switch itself while applying, so availability is bound on a wrapper. -->
                            <Border IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center"
                                    ToolTip="{Binding UnavailableReason}" ToolTipService.ShowOnDisabled="True">
                                <ui:ToggleSwitch IsOn="{Binding IsEnabled, Mode=TwoWay}" Style="{StaticResource SettingSwitchStyle}"
                                                 VerticalAlignment="Center" HorizontalAlignment="Right"
                                                 Tag="{Binding}" AutomationProperties.Name="{Binding Name}"
                                                 Toggled="TweakToggle_Toggled"/>
                            </Border>
                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource FluentIconFont}" FontSize="16" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Foreground="{DynamicResource IconSecondaryBrush}"
                                       Visibility="{Binding IsRestartPending, Converter={StaticResource BoolToVis}}"
                                       ToolTip="{loc:Loc Tweaks:RegistryTweaksPageRestartWindowsToMakeThis}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}" Margin="0,6,0,4">
                        <TextBlock Text="{Binding Description}" Style="{StaticResource TweakDescriptionStyle}"/>
                        <TextBlock Text="{Binding UnavailableReason}" Style="{StaticResource DescriptionTextStyle}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVis}}"/>
                        <Border Style="{StaticResource TweakCommandSurfaceStyle}">
                            <TextBox Text="{Binding PreviewContent, Mode=OneWay}" Style="{StaticResource CommandPreviewTextStyle}"
                                     AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPagePreviewRegistryChanges}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CustomTweakTemplate">
            <Border Style="{StaticResource TweakItemStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontSize="14" TextWrapping="Wrap">
                            <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  ·&#x00A0;"/><Hyperlink
                                Style="{StaticResource RiskExplanationLinkStyle}" FontSize="12" ToolTip="{Binding RiskHint}"
                                Click="RiskExplanation_Click"><Run Text="{Binding RiskText, Mode=OneWay}"/></Hyperlink>
                        </TextBlock>
                        <StackPanel x:Name="RowActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource FluentIconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}" Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}"
                                       ToolTip="{loc:Loc Tweaks:RegistryTweaksPageThisRegistryValueCurrentlyMatches}"/>
                            <Button Style="{StaticResource FavoriteStarButtonStyle}" Margin="0,0,8,0"
                                    Click="FavoriteTweak_Click" ToolTip="{loc:Loc Tweaks:RegistryTweaksPageAddOrRemoveFromFavorites2}"
                                    AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPageToggleFavorite2}" Content="{Binding}"
                                    ContentTemplate="{StaticResource FavoriteStarTemplate}"/>
                            <Button Style="{StaticResource CommandPreviewButtonStyle}" Margin="0,0,8,0" Content="{Binding}"
                                    Click="ViewCustomTweak_Click" Tag="{Binding ElementName=CustomPreviewPanel}"
                                    AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPagePreviewRegistryChanges}"
                                    ToolTip="{loc:Loc Tweaks:RegistryTweaksPagePreviewRegistryChanges2}"/>
                            <Button Style="{StaticResource ExecuteButtonStyle}" Margin="0,0,8,0" Click="ApplyCustomTweak_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource FluentIconFont}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageApply}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="RestoreCustomTweak_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource FluentIconFont}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageRestore}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="EditCustomTweak_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FluentIconFont}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageEdit}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButtonStyle}" Click="DeleteCustomTweak_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FluentIconFont}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageDelete}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="CustomPreviewPanel" Tag="{Binding ElementName=CustomPreviewText}" Margin="0,6,0,4" Visibility="Collapsed">
                        <TextBlock Text="{Binding Description}" Style="{StaticResource TweakDescriptionStyle}"/>
                        <Border Style="{StaticResource CommandPreviewSurfaceStyle}">
                            <TextBox x:Name="CustomPreviewText" Style="{StaticResource CommandPreviewTextStyle}"
                                     AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPagePreviewRegistryChanges}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="32,24,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <controls:SectionHeading PageTitle="{loc:Loc Tweaks:RegistryTweaksPageRegistryTweaks2}"
                                         Tabs="{Binding ElementName=RegistryTabs}" Margin="0,0,0,6"/>
                <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageOptimizeWindowsPerformanceThroughRegistry}"
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding LastBackupStatusText}" FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       VerticalAlignment="Top" Margin="0,6,0,0"/>
        </Grid>

        <WrapPanel x:Name="RegistryActions" Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButtonStyle}"
                    AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPageRefreshStatus}"
                    Click="RefreshButton_Click" Margin="0,0,8,6">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource RefreshIconGeometry}" Style="{StaticResource ToolbarIconStyle}"/>
                    <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageRefreshStatus}" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>
            <Button x:Name="BackupButton" Style="{StaticResource SecondaryButtonStyle}"
                    AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPageCreateBackup}"
                    Click="BackupButton_Click" Margin="0,0,8,6">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource BackupIconGeometry}" Style="{StaticResource ToolbarIconStyle}"/>
                    <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageCreateBackup}" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>
            <Button x:Name="CreateRestorePointButton" Style="{StaticResource SecondaryButtonStyle}"
                    AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPageCreateRestorePoint}"
                    Click="CreateRestorePointButton_Click" Margin="0,0,8,6">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource RestorePointIconGeometry}" Style="{StaticResource ToolbarIconStyle}"/>
                    <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageCreateRestorePoint}" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>
            <Button x:Name="ApplyAllButton" Style="{StaticResource ModernButtonStyle}"
                    AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPageApplyRecommended}"
                    Click="ApplyAllButton_Click" Margin="0,0,8,6">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CheckIconGeometry}" Style="{StaticResource ToolbarIconStyle}"/>
                    <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageApplyRecommended}" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>
            <Button x:Name="RestoreAllButton" Style="{StaticResource SecondaryButtonStyle}"
                    AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPageRestoreAllChanges}"
                    Click="RestoreAllButton_Click" IsEnabled="False" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource HistoryIconGeometry}" Style="{StaticResource ToolbarIconStyle}"/>
                    <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageRestoreAllChanges}" Style="{StaticResource ToolbarLabelStyle}"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <Grid Grid.Row="2">
            <TabControl x:Name="RegistryTabs" Style="{StaticResource PaddedTabControl}" ItemContainerStyle="{StaticResource FluentTabItemStyle}">
                <TabItem Header="{loc:Loc Tweaks:RegistryTweaksPageRecommended}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,16,0">
                        <StackPanel>
                            <Border x:Name="RevertedTweaksBanner" Style="{StaticResource CardStyle}" Margin="0,0,0,20"
                                    BorderBrush="{DynamicResource WarningBrush}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FluentIconFont}" FontSize="18" Margin="0,2,10,0"
                                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc Tweaks:RevertedTweaksTitle}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="RevertedTweaksText" Style="{StaticResource DescriptionTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="ReapplyRevertedButton" Grid.Column="2" Style="{StaticResource ModernButtonStyle}"
                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                            Content="{loc:Loc Tweaks:RevertedTweaksReapply}" Click="ReapplyReverted_Click"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource FluentIconFont}" FontSize="18" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource IconBrush}"/>
                                        <TextBlock Text="{loc:Loc Tweaks:WindowsUpdatePresets}" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <WrapPanel x:Name="WindowsUpdatePresetActions" Margin="26,0,0,4" IsEnabled="False">
                                        <ComboBox x:Name="WindowsUpdatePresetComboBox" Width="308" MinHeight="32" SelectedValuePath="Tag"
                                                  Margin="0,0,8,4" Style="{StaticResource FluentDropDownStyle}"
                                                  ui:ControlHelper.PlaceholderText="{loc:Loc Tweaks:WindowsUpdatePresetCustom}"
                                                  AutomationProperties.Name="{loc:Loc Tweaks:WindowsUpdatePresets}"
                                                  SelectionChanged="WindowsUpdatePreset_SelectionChanged">
                                            <ComboBoxItem Content="{loc:Loc Tweaks:WindowsUpdatePresetDefault}" Tag="Default"/>
                                            <ComboBoxItem Content="{loc:Loc Tweaks:WindowsUpdatePresetDisabled}" Tag="Disabled"/>
                                            <ComboBoxItem Content="{loc:Loc Tweaks:WindowsUpdatePresetSecurity}" Tag="Security"/>
                                        </ComboBox>
                                        <Button Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,4"
                                                Content="{loc:Loc Tweaks:Apply}" Click="ApplyWindowsUpdatePreset_Click"/>
                                        <Button Style="{StaticResource CommandPreviewButtonStyle}" Margin="0,0,0,4"
                                                Content="{Binding}" Click="PreviewWindowsUpdatePreset_Click"
                                                AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPagePreviewRegistryChanges}"
                                                ToolTip="{loc:Loc Tweaks:RegistryTweaksPagePreviewRegistryChanges}"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="WindowsUpdatePresetStatusText" Margin="26,0,0,0" FontWeight="Normal"
                                               Text="{loc:Loc UI:LoadingWindowsUpdateStatus}"
                                               TextWrapping="Wrap"/>
                                    <StackPanel x:Name="WindowsUpdatePresetPreview" Visibility="Collapsed" Margin="26,8,0,0">
                                        <TextBlock x:Name="WindowsUpdatePresetDescriptionText" Style="{StaticResource TweakDescriptionStyle}"/>
                                        <Border x:Name="WindowsUpdatePresetCommand" Style="{StaticResource CommandPreviewSurfaceStyle}">
                                            <TextBox x:Name="WindowsUpdatePresetPreviewText" Style="{StaticResource CommandPreviewTextStyle}"
                                                     AutomationProperties.Name="{loc:Loc Tweaks:RegistryTweaksPagePreviewRegistryChanges}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="{loc:Loc Tweaks:RiskFilterLabel}" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Style="{StaticResource DescriptionTextStyle}"/>
                                <ComboBox x:Name="RiskFilterBox" Width="220" SelectedIndex="0" SelectionChanged="RiskFilter_SelectionChanged"
                                          MinHeight="32" Style="{StaticResource FluentDropDownStyle}"
                                          AutomationProperties.Name="{loc:Loc Tweaks:RiskFilterLabel}">
                                    <ComboBoxItem Content="{loc:Loc Tweaks:RiskFilterAll}" Tag="All"/>
                                    <ComboBoxItem Content="{loc:Loc Tweaks:RiskFilterRecommended}" Tag="Recommended"/>
                                    <ComboBoxItem Content="{loc:Loc Tweaks:RiskSafe}" Tag="Safe"/>
                                    <ComboBoxItem Content="{loc:Loc Tweaks:RiskCosmetic}" Tag="Cosmetic"/>
                                    <ComboBoxItem Content="{loc:Loc Tweaks:RiskModerate}" Tag="Moderate"/>
                                    <ComboBoxItem Content="{loc:Loc Tweaks:RiskCaution}" Tag="Caution"/>
                                </ComboBox>
                                <TextBlock x:Name="RiskFilterCount" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <ItemsControl x:Name="TweakCategoriesControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,32">
                                        <StackPanel Margin="0,4,0,10">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RegistryGroupHeadingStyle}"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource DescriptionTextStyle}"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Tweaks}" ItemTemplate="{StaticResource BuiltInTweakTemplate}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Loc Tweaks:RegistryTweaksPageCustomTweaks}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
                        <StackPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageCustomRegistryTweaks}" Style="{StaticResource RegistryGroupHeadingStyle}"/>
                                        <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageCreateAndManageYourOwn}"
                                                   Style="{StaticResource DescriptionTextStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}"
                                            Click="AddCustomTweak_Click" MinWidth="140" Padding="16,8"
                                            AutomationProperties.Name="{loc:Loc Tweaks:AddCustomRegistryTweak}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource AddIconGeometry}" Style="{StaticResource ToolbarIconStyle}"/>
                                            <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageNewTweak}" Style="{StaticResource ToolbarLabelStyle}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="CustomTweaksList" ItemTemplate="{StaticResource CustomTweakTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Loc Tweaks:RegistryTweaksPageFavorites}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,16,0">
                        <StackPanel>
                            <TextBlock x:Name="FavoritesEmptyText" Text="{loc:Loc Tweaks:RegistryTweaksPageNoFavoriteRegistryTweaksYet}"
                                       HorizontalAlignment="Center" Margin="0,32" FontSize="13"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            <StackPanel x:Name="FavoriteBuiltInSection">
                                <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageRecommended2}" Style="{StaticResource RegistryGroupHeadingStyle}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="FavoriteBuiltInTweaksList" ItemTemplate="{StaticResource BuiltInTweakTemplate}"/>
                            </StackPanel>
                            <StackPanel x:Name="FavoriteCustomSection" Margin="0,16,0,0">
                                <TextBlock Text="{loc:Loc Tweaks:RegistryTweaksPageCustomTweaks2}" Style="{StaticResource RegistryGroupHeadingStyle}" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="FavoriteCustomTweaksList" ItemTemplate="{StaticResource CustomTweakTemplate}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        <controls:LoadingOverlay x:Name="InitialLoading" Grid.RowSpan="3"/>
    </Grid>
</Page>
