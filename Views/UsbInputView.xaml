<UserControl x:Class="TweakHub.Views.UsbInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TweakHub.Localization"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBorderBaseLowBrush}"/>
                <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,12,0">
        <StackPanel>
            <Grid Margin="4,0,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Devices:UsbDescription}" Style="{StaticResource DescriptionTextStyle}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <ui:ProgressRing x:Name="BusyRing" Width="20" Height="20" Margin="0,0,10,0" IsActive="False"/>
                    <Button x:Name="ScanButton" Click="Scan_Click" Style="{StaticResource ModernButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc Devices:Scan}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="4,0,4,8" Visibility="Collapsed"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Plan-wide selective suspend -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock x:Name="PlanSuspendIcon" Text="&#xE945;" Style="{StaticResource IconTextStyle}" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource IconBrush}"/>
                            <TextBlock Text="{loc:Loc Devices:PlanSuspendTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Devices:PlanSuspendDescription}" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="PlanSuspendText" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button x:Name="PlanSuspendButton" Click="PlanSuspend_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"
                                    Content="{loc:Loc Devices:PlanSuspendDisable}"/>
                            <Button x:Name="PlanSuspendRestoreButton" Click="PlanSuspendRestore_Click" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{loc:Loc Devices:RestoreOriginal}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Polling test -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE962;" Style="{StaticResource IconTextStyle}" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource IconBrush}"/>
                            <TextBlock Text="{loc:Loc Devices:PollingTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Devices:PollingDescription}" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock x:Name="PollingValue" Text="–" FontSize="36" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Text="Hz" Style="{StaticResource LabelTextStyle}"/>
                                <Button x:Name="PollingButton" Click="Polling_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,12,0,0"
                                        Content="{loc:Loc Devices:PollingStart}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="PollingStatus" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,8"/>
                                <StackPanel x:Name="PollingChart"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{loc:Loc Devices:InputDevicesTitle}" Style="{StaticResource CategoryHeaderStyle}" Margin="4,12,4,8"/>
            <TextBlock x:Name="NoInputText" Text="{loc:Loc Devices:NoInputDevices}" Style="{StaticResource DescriptionTextStyle}" Margin="4,0,4,8"
                       Visibility="Collapsed"/>
            <ItemsControl x:Name="InputList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource IconTextStyle}" FontSize="18" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource IconBrush}"/>
                                        <TextBlock Text="{Binding Chain.Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        <TextBlock Text="{Binding Chain.KindText}" Style="{StaticResource LabelTextStyle}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Hops}" Margin="0,6,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border ToolTip="{Binding Detail}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHub}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="&#xE76C;" Style="{StaticResource IconTextStyle}" FontSize="10" Margin="0,0,6,6"
                                                               Foreground="{DynamicResource IconSecondaryBrush}" Visibility="{Binding ArrowVisibility}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource DescriptionTextStyle}">
                                        <Run Text="{Binding Chain.HubText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding ControllerModeText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding SuspendText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Click="DeviceSuspend_Click" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding SuspendActionText}"
                                            Visibility="{Binding SuspendActionVisibility}" ToolTip="{loc:Loc Security:RequiresAdministrator}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
