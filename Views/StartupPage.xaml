<Page x:Class="TweakHub.Views.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:TweakHub.Localization"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:controls="clr-namespace:TweakHub.Views.Controls"
      Title="{loc:Loc Security:StartupPageTitle}"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Loc Security:StartupPageTitle}" FontSize="28" FontWeight="Light" Margin="0,0,0,6"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                <TextBlock Text="{loc:Loc Security:StartupPageDescription}" Style="{StaticResource DescriptionTextStyle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource DescriptionTextStyle}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                <Button x:Name="ScanButton" Click="Scan_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc Security:SystemScan}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ElevatedScanButton" Click="ElevatedScan_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        ToolTip="{loc:Loc Security:StartupScanElevatedHint}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc Security:SystemScanElevated}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Click="Export_Click" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc Security:ExportReport}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <ComboBox x:Name="CategoryBox" Width="220" Margin="0,0,12,4" SelectionChanged="Filter_Changed"
                      AutomationProperties.Name="{loc:Loc Security:ColumnCategory}"/>
            <TextBox x:Name="SearchBox" Width="240" Margin="0,0,12,4" TextChanged="Filter_Changed"
                     ui:ControlHelper.PlaceholderText="{loc:Loc Security:FilterPlaceholder}"
                     AutomationProperties.Name="{loc:Loc Security:FilterPlaceholder}"/>
            <CheckBox x:Name="HideMicrosoft" Content="{loc:Loc Security:StartupHideMicrosoft}" IsChecked="True" Margin="0,0,12,4"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="UnsignedOnly" Content="{loc:Loc Security:StartupUnsignedOnly}" Margin="0,0,12,4"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="MissingOnly" Content="{loc:Loc Security:StartupMissingOnly}" Margin="0,0,12,4"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        </WrapPanel>

        <!-- Outside a ScrollViewer so the rows stay virtualized: an elevated scan lists several hundred entries. -->
        <DataGrid x:Name="StartupGrid" Grid.Row="3" Style="{StaticResource TriageGridStyle}" MaxHeight="Infinity" FrozenColumnCount="2"
                  HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{loc:Loc Security:ColumnName}" Width="240" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Name}">
                                <TextBlock Style="{StaticResource TrustIconStyle}" Margin="0,0,8,0" ToolTip="{Binding TrustText}"/>
                                <Border Background="{DynamicResource WarningBrush}" CornerRadius="3" Padding="5,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        ToolTip="{loc:Loc Security:StartupFileMissingHint}"
                                        Visibility="{Binding IsMissing, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{loc:Loc Security:StartupFileMissing}" FontSize="10" Foreground="Black"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Click="Toggle_Click" Style="{StaticResource SecondaryButtonStyle}" MinHeight="26" Padding="8,1" Margin="0,0,4,0"
                                        Content="{Binding ToggleText}" AutomationProperties.Name="{Binding ToggleText}"
                                        Visibility="{Binding CanToggle, Converter={StaticResource Visible}}"/>
                                <Button Click="Delete_Click" Style="{StaticResource SmallIconButtonStyle}"
                                        ToolTip="{loc:Loc Security:StartupDelete}" AutomationProperties.Name="{loc:Loc Security:StartupDelete}"
                                        Visibility="{Binding CanDelete, Converter={StaticResource Visible}}">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconTextStyle}" FontSize="12" Foreground="{DynamicResource DangerBrush}"/>
                                </Button>
                                <!-- Protected entries show why instead of a Delete button. -->
                                <TextBlock Text="&#xE72E;" FontSize="12" Width="28" TextAlignment="Center"
                                           ToolTip="{Binding ProtectionText}" AutomationProperties.Name="{Binding ProtectionText}" Focusable="True"
                                           Foreground="{DynamicResource IconSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Click="JumpToEntry_Click" Style="{StaticResource SmallIconButtonStyle}"
                                        ToolTip="{loc:Loc Security:StartupJumpToEntry}" AutomationProperties.Name="{loc:Loc Security:StartupJumpToEntry}">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource IconTextStyle}" FontSize="12"/>
                                </Button>
                                <Button Click="Properties_Click" Style="{StaticResource SmallIconButtonStyle}"
                                        ToolTip="{loc:Loc Security:StartupFileProperties}" AutomationProperties.Name="{loc:Loc Security:StartupFileProperties}">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconTextStyle}" FontSize="12"/>
                                </Button>
                                <Button Click="AnalyzeFile_Click" Style="{StaticResource SmallIconButtonStyle}"
                                        ToolTip="{loc:Loc Security:AnalyzeFile}" AutomationProperties.Name="{loc:Loc Security:AnalyzeFile}">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource IconTextStyle}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Loc Security:ColumnType}" Binding="{Binding KindText}" Width="130"/>
                <DataGridTextColumn Header="{loc:Loc Security:ColumnState}" Binding="{Binding StatusText}" Width="90"/>
                <DataGridTextColumn Header="{loc:Loc Security:ColumnSigner}" Binding="{Binding TrustText}" Width="170"/>
                <DataGridTextColumn Header="{loc:Loc Security:ColumnTrigger}" Binding="{Binding TriggerText}" Width="150"/>
                <DataGridTextColumn Header="{loc:Loc Security:ColumnUser}" Binding="{Binding User}" Width="110"/>
                <DataGridTextColumn Header="{loc:Loc Security:ColumnLastRun}" Binding="{Binding LastRunText}" Width="130" SortMemberPath="LastRun"/>
                <DataGridTextColumn Header="{loc:Loc Security:ColumnNextRun}" Binding="{Binding NextRunText}" Width="130" SortMemberPath="NextRun"/>
                <DataGridTextColumn Header="{loc:Loc Security:ColumnImage}" Binding="{Binding Path}" Width="260"/>
                <DataGridTemplateColumn Header="{loc:Loc Security:ColumnCommand}" Width="300" SortMemberPath="Command">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Command}" ToolTip="{Binding Command}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{loc:Loc Security:ColumnLocation}" Width="280" SortMemberPath="Location">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Location}" ToolTip="{Binding Location}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Loc Security:ColumnFileDate}" Binding="{Binding FileDateText}" Width="100" SortMemberPath="FileDate"/>
            </DataGrid.Columns>
        </DataGrid>

        <Expander x:Name="BackupsExpander" Grid.Row="4" Margin="0,12,0,0">
            <DataGrid x:Name="BackupsGrid" Style="{StaticResource TriageGridStyle}" MaxHeight="220" Margin="0,8,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Security:ColumnDeleted}" Binding="{Binding DeletedText}" Width="140" SortMemberPath="DeletedAt"/>
                    <DataGridTextColumn Header="{loc:Loc Security:ColumnName}" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="{loc:Loc Security:ColumnType}" Binding="{Binding Entry.KindText}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Loc Security:ColumnLocation}" Binding="{Binding Location}" Width="3*"/>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="Restore_Click" Style="{StaticResource SecondaryButtonStyle}" MinHeight="26" Padding="10,1"
                                        Content="{loc:Loc Security:StartupRestore}" AutomationProperties.Name="{loc:Loc Security:StartupRestore}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Expander>
    </Grid>
    <controls:LoadingOverlay x:Name="Loading"/>
    </Grid>
</Page>
