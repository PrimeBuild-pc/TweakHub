<Page x:Class="TweakHub.Views.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:TweakHub.Localization"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:controls="clr-namespace:TweakHub.Views.Controls"
      Title="{loc:Loc Security:StartupPageTitle}"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible"/>
            <Style x:Key="StartupCellTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="10,0,8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
    <Grid Margin="32,24,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Loc Security:StartupPageTitle}" Style="{StaticResource PageHeadingTextStyle}" Margin="0,0,0,6"/>
                <TextBlock Text="{loc:Loc Security:StartupPageDescription}" Style="{StaticResource PageSubtitleTextStyle}"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource DescriptionTextStyle}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                <Button x:Name="ScanButton" Click="Scan_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,4"
                        AutomationProperties.Name="{loc:Loc Security:SystemScan}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource RefreshIconGeometry}" Style="{StaticResource ToolbarIconStyle}"/>
                        <TextBlock Text="{loc:Loc Security:SystemScan}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ElevatedScanButton" Click="ElevatedScan_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4"
                        ToolTip="{loc:Loc Security:StartupScanElevatedHint}" AutomationProperties.Name="{loc:Loc Security:SystemScanElevated}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc Security:SystemScanElevated}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Click="Export_Click" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                        AutomationProperties.Name="{loc:Loc Security:ExportReport}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" Style="{StaticResource IconTextStyle}" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc Security:ExportReport}"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <ComboBox x:Name="CategoryBox" Style="{StaticResource FluentDropDownStyle}" Width="220" Margin="0,0,12,4" SelectionChanged="Filter_Changed"
                      AutomationProperties.Name="{loc:Loc Security:ColumnCategory}"/>
            <TextBox x:Name="SearchBox" Style="{StaticResource FieldInputStyle}" Width="240" Margin="0,0,12,4" TextChanged="Filter_Changed"
                     ui:ControlHelper.PlaceholderText="{loc:Loc Security:FilterPlaceholder}"
                     AutomationProperties.Name="{loc:Loc Security:FilterPlaceholder}"/>
            <CheckBox x:Name="HideMicrosoft" Content="{loc:Loc Security:StartupHideMicrosoft}" IsChecked="True" Margin="0,0,12,4"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="UnsignedOnly" Content="{loc:Loc Security:StartupUnsignedOnly}" Margin="0,0,12,4"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <CheckBox x:Name="MissingOnly" Content="{loc:Loc Security:StartupMissingOnly}" Margin="0,0,12,4"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
        </WrapPanel>

        <!-- Keep the inventory virtualized for large scans. -->
        <DataGrid x:Name="StartupGrid" Grid.Row="3" Style="{StaticResource TriageGridStyle}" MaxHeight="Infinity"
                  CanUserReorderColumns="False" GridLinesVisibility="None" MinRowHeight="44"
                  HorizontalScrollBarVisibility="Disabled" SelectionChanged="StartupGrid_SelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{loc:Loc Security:ColumnName}" Width="3*" MinWidth="150" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Name}">
                                <Border Width="3" Height="16" CornerRadius="1.5" Margin="2,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource FluentAccentBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <StackPanel Margin="10,5,8,5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{loc:Loc Security:StartupFileMissing}" FontSize="11"
                                               ToolTip="{loc:Loc Security:StartupFileMissingHint}"
                                               Visibility="{Binding IsMissing, Converter={StaticResource Visible}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Loc Security:ColumnType}" Binding="{Binding KindText}" Width="*" MinWidth="92"
                                    ElementStyle="{StaticResource StartupCellTextStyle}"/>
                <DataGridTextColumn Header="{loc:Loc Security:ColumnState}" Binding="{Binding StatusText}" Width="*" MinWidth="92"
                                    ElementStyle="{StaticResource StartupCellTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" DataContext="{Binding SelectedItem, ElementName=StartupGrid}" Margin="0,8,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
                    <Setter Property="Padding" Value="12"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource CategoryHeaderStyle}" TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,6"/>
                <WrapPanel>
                    <Button Click="Toggle_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4"
                            Content="{Binding ToggleText}" Visibility="{Binding CanToggle, Converter={StaticResource Visible}}"/>
                    <Button Click="JumpToEntry_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4"
                            Content="{loc:Loc Security:StartupJumpToEntry}"/>
                    <Button Click="Properties_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4"
                            Content="{loc:Loc Security:StartupFileProperties}"/>
                    <Button Click="AnalyzeFile_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,4"
                            Content="{loc:Loc Security:AnalyzeFile}"/>
                    <Button Click="Delete_Click" Style="{StaticResource DangerButtonStyle}" Margin="0,0,6,4"
                            Content="{loc:Loc Security:StartupDelete}" Visibility="{Binding CanDelete, Converter={StaticResource Visible}}"/>
                </WrapPanel>
                <TextBlock Text="{Binding ProtectionText}" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DescriptionTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Expander Header="{loc:Loc Tweaks:RegistryTweaksPageDetails}" Margin="0,4,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="112">
                        <ItemsControl x:Name="EntryDetails" Margin="0,4,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="144"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource DescriptionTextStyle}" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource ValueTextStyle}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Border>

        <Expander x:Name="BackupsExpander" Grid.Row="5" Margin="0,12,0,0">
            <DataGrid x:Name="BackupsGrid" Style="{StaticResource TriageGridStyle}" MaxHeight="220" Margin="0,8,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Security:ColumnDeleted}" Binding="{Binding DeletedText}" Width="140" SortMemberPath="DeletedAt"/>
                    <DataGridTextColumn Header="{loc:Loc Security:ColumnName}" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="{loc:Loc Security:ColumnType}" Binding="{Binding Entry.KindText}" Width="Auto"/>
                    <DataGridTextColumn Header="{loc:Loc Security:ColumnLocation}" Binding="{Binding Location}" Width="3*"/>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="Restore_Click" Style="{StaticResource SecondaryButtonStyle}" MinHeight="26" Padding="10,1"
                                        Content="{loc:Loc Security:StartupRestore}" AutomationProperties.Name="{loc:Loc Security:StartupRestore}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Expander>
    </Grid>
    <controls:LoadingOverlay x:Name="Loading"/>
    </Grid>
</Page>
