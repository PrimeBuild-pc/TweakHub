<Window x:Class="TweakHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:TweakHub.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        Title="{loc:Loc UI:MainWindowTweakHubWindows11TweakUtility}"
        Height="900" Width="1400"
        MinHeight="620" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Icon="ico.ico"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource NavigationBrush}">

    <!-- The title is drawn by TweakHub (the system caption cannot show italics); Windows still draws the caption buttons,
         so snap layouts, the system menu and dark mode keep working. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" UseAeroCaptionButtons="True"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
        <RowDefinition Height="32"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Background="Transparent">
        <Image Source="ico.ico" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                   AutomationProperties.Name="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
            <Run Text="TweakHub"/>
            <Run Text="by Prime Build" FontStyle="Italic" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </TextBlock>
    </StackPanel>

    <ui:NavigationView x:Name="Navigation" Grid.Row="1" Margin="12,0,0,0"
                       PaneDisplayMode="Auto"
                       CompactModeThresholdWidth="0"
                       ExpandedModeThresholdWidth="1120"
                       IsBackButtonVisible="Collapsed"
                       IsSettingsVisible="False"
                       AlwaysShowHeader="False"
                       OpenPaneLength="252"
                       Background="Transparent"
                       SelectionChanged="Navigation_SelectionChanged">
        <ui:NavigationView.Style>
            <Style TargetType="ui:NavigationView" BasedOn="{StaticResource {x:Type ui:NavigationView}}">
                <Style.Triggers>
                    <Trigger Property="DisplayMode" Value="Expanded">
                        <Setter Property="IsPaneToggleButtonVisible" Value="False"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ui:NavigationView.Style>
        <ui:NavigationView.Resources>
            <Style x:Key="CategoryIconStyle" TargetType="ui:BitmapIcon">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value><ScaleTransform ScaleX="1.2" ScaleY="1.2"/></Setter.Value>
                </Setter>
                <Setter Property="ShowAsMonochrome" Value="{DynamicResource {x:Static SystemParameters.HighContrastKey}}"/>
            </Style>
        </ui:NavigationView.Resources>
        <ui:NavigationView.MenuItemContainerStyle>
            <Style TargetType="ui:NavigationViewItem" BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Margin" Value="0,2,10,2"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>
        </ui:NavigationView.MenuItemContainerStyle>
        <ui:NavigationView.PaneHeader>
            <TextBlock Text="TweakHub" FontSize="20" FontWeight="SemiBold" Margin="12,22,12,18"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </ui:NavigationView.PaneHeader>

        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem x:Name="RegistryTweaksItem" Tag="registry"
                                   ToolTip="{loc:Loc UI:MainWindowRegistryTweaks}"
                                   AutomationProperties.Name="{loc:Loc UI:MainWindowRegistryTweaks}">
                <ui:NavigationViewItem.Icon>
                    <ui:BitmapIcon Style="{StaticResource CategoryIconStyle}" UriSource="pack://application:,,,/Resources/Navigation/registry.png"/>
                </ui:NavigationViewItem.Icon>
                <Grid Width="164">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc UI:MainWindowRegistryTweaks}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="RegistryTweaksBadge" Grid.Column="1" MinWidth="18" Height="18" Padding="3,0"
                            CornerRadius="9" Background="{DynamicResource FluentAccentBrush}"
                            Margin="10,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="RegistryTweaksBadgeText" Text="0" FontSize="10"
                                   Foreground="{DynamicResource FluentAccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="ExternalToolsItem" Content="{loc:Loc UI:MainWindowExternalTools}" Tag="tools">
                <ui:NavigationViewItem.Icon>
                    <ui:BitmapIcon Style="{StaticResource CategoryIconStyle}" UriSource="pack://application:,,,/Resources/Navigation/tools.png"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="SecurityItem" Content="{loc:Loc Tools:SecurityTitle}" Tag="security"
                                   AutomationProperties.Name="{loc:Loc Tools:SecurityTitle}">
                <ui:NavigationViewItem.Icon>
                    <ui:BitmapIcon Style="{StaticResource CategoryIconStyle}" UriSource="pack://application:,,,/Resources/Navigation/security.png"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="StartupItem" Content="{loc:Loc Security:StartupPageTitle}" Tag="startup"
                                   AutomationProperties.Name="{loc:Loc Security:StartupPageTitle}">
                <ui:NavigationViewItem.Icon>
                    <ui:BitmapIcon Style="{StaticResource CategoryIconStyle}" UriSource="pack://application:,,,/Resources/Navigation/startup.png"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="DevicesItem" Content="{loc:Loc Devices:Title}" Tag="devices"
                                   AutomationProperties.Name="{loc:Loc Devices:Title}">
                <ui:NavigationViewItem.Icon>
                    <ui:BitmapIcon Style="{StaticResource CategoryIconStyle}" UriSource="pack://application:,,,/Resources/Navigation/devices.png"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="PowerItem" Content="{loc:Loc Tweaks:PowerSectionTitle}" Tag="power"
                                   AutomationProperties.Name="{loc:Loc Tweaks:PowerSectionTitle}">
                <ui:NavigationViewItem.Icon>
                    <ui:BitmapIcon Style="{StaticResource CategoryIconStyle}" UriSource="pack://application:,,,/Resources/Navigation/power.png"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="AutomatedScriptsItem" Content="{loc:Loc UI:MainWindowAutomatedScripts}" Tag="scripts">
                <ui:NavigationViewItem.Icon>
                    <ui:BitmapIcon Style="{StaticResource CategoryIconStyle}" UriSource="pack://application:,,,/Resources/Navigation/scripts.png"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="QuickAccessItem" Content="{loc:Loc UI:MainWindowQuickAccess}" Tag="quick">
                <ui:NavigationViewItem.Icon>
                    <ui:BitmapIcon Style="{StaticResource CategoryIconStyle}" UriSource="pack://application:,,,/Resources/Navigation/quick.png"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="SettingsItem" Content="{loc:Loc UI:MainWindowAbout}" Tag="settings">
                <ui:NavigationViewItem.Icon>
                    <ui:BitmapIcon Style="{StaticResource CategoryIconStyle}" UriSource="pack://application:,,,/Resources/Navigation/settings.png"/>
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <ui:NavigationView.PaneFooter>
            <Button Margin="0,8,10,16" Padding="12,8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    ToolTip="{loc:Loc UI:MainWindowOpenAppearanceSettings}"
                    AutomationProperties.Name="{loc:Loc UI:MainWindowAppearanceSettings}"
                    Click="AppearanceSettings_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaneOpen, ElementName=Navigation}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:BitmapIcon Style="{StaticResource CategoryIconStyle}" Margin="0,0,12,0" VerticalAlignment="Center"
                                   UriSource="pack://application:,,,/Resources/Navigation/appearance.png"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:Loc UI:MainWindowAppearanceSettings2}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AppearanceStatusText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </ui:NavigationView.PaneFooter>

        <Border Margin="0,8,0,0" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0"
                BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}"
                Background="{DynamicResource WindowBackgroundBrush}">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
        </Border>
    </ui:NavigationView>
    </Grid>
</Window>
