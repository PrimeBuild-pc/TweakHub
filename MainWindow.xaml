<Window x:Class="TweakHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:TweakHub.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        Title="{loc:Loc UI:MainWindowTweakHubWindows11TweakUtility}"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Icon="ico.ico"
        FontFamily="Segoe UI Variable Text"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBackgroundBrush}">

    <ui:NavigationView x:Name="Navigation"
                       PaneDisplayMode="Left"
                       IsPaneOpen="True"
                       IsPaneToggleButtonVisible="False"
                       IsBackButtonVisible="Collapsed"
                       IsSettingsVisible="False"
                       AlwaysShowHeader="False"
                       OpenPaneLength="280"
                       Background="{DynamicResource WindowBackgroundBrush}"
                       SelectionChanged="Navigation_SelectionChanged">
        <ui:NavigationView.PaneHeader>
            <StackPanel Margin="12,18,12,14">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{DynamicResource SubtleFillBrush}"
                            BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1">
                        <Image Source="ico.ico" Width="24" Height="24"/>
                    </Border>
                    <TextBlock Text="TweakHub" FontSize="20" FontWeight="SemiBold"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                </StackPanel>
                <TextBlock Text="{loc:Loc UI:MainWindowWindows11PerformanceControls}" Margin="48,0,0,0" FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
        </ui:NavigationView.PaneHeader>

        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem x:Name="RegistryTweaksItem" Tag="registry">
                <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE945;"/></ui:NavigationViewItem.Icon>
                <Grid Width="190">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc UI:MainWindowRegistryTweaks}" VerticalAlignment="Center"/>
                    <Border x:Name="RegistryTweaksBadge" Grid.Column="1" Width="18" Height="18"
                            CornerRadius="9" Background="{DynamicResource AccentBrush}"
                            Margin="10,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="RegistryTweaksBadgeText" Text="0" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="ExternalToolsItem" Content="{loc:Loc UI:MainWindowExternalTools}" Tag="tools">
                <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE90F;"/></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="AutomatedScriptsItem" Content="{loc:Loc UI:MainWindowAutomatedScripts}" Tag="scripts">
                <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE756;"/></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="QuickAccessItem" Content="{loc:Loc UI:MainWindowQuickAccess}" Tag="quick">
                <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE8F1;"/></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="SettingsItem" Content="{loc:Loc UI:MainWindowAbout}" Tag="settings">
                <ui:NavigationViewItem.Icon><ui:FontIcon Glyph="&#xE713;"/></ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <ui:NavigationView.PaneFooter>
            <Border Margin="12" Padding="12,10" CornerRadius="8"
                    BorderBrush="{DynamicResource SystemControlBorderBaseLowBrush}" BorderThickness="1"
                    Cursor="Hand" ToolTip="{loc:Loc UI:MainWindowOpenAppearanceSettings}"
                    AutomationProperties.Name="{loc:Loc UI:MainWindowAppearanceSettings}"
                    Focusable="True" KeyboardNavigation.IsTabStop="True"
                    MouseLeftButtonUp="AppearanceSettings_Click" KeyDown="AppearanceSettings_KeyDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,10,0"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc UI:MainWindowAppearanceSettings2}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock x:Name="AppearanceStatusText" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="190"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ui:NavigationView.PaneFooter>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
    </ui:NavigationView>
</Window>
